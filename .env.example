# URL del Web App de Google Apps Script que recibe el formulario de contacto
# Deploy → Apps Script → "Implementar como aplicación web" → pega aquí la URL /exec
PUBLIC_CONTACT_SHEET_URL=

# Analítica sin cookies: crea el sitio en https://cloud.umami.is y pega aquí su "Website ID".
# Vacío = no se carga ningún script de analítica.
PUBLIC_UMAMI_WEBSITE_ID=
