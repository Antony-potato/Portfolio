---
interface Props {
  index: string;
  label: string;
  title: string;
  description?: string;
  class?: string;
}

const { index, label, title, description, class: className = "" } = Astro.props;
---

<header class={className}>
  <div class="eyebrow flex items-center gap-4">
    <span class="text-fg">{index}</span>
    <span data-line class="h-px flex-1 bg-line"></span>
    <span>{label}</span>
  </div>
  <div class="mt-8 grid items-end gap-6 md:mt-10 lg:grid-cols-12">
    <h2
      data-reveal="lines"
      class="text-[clamp(2.5rem,7vw,7rem)] leading-[0.92] tracking-[-0.05em] lg:col-span-8"
    >
      {title}
    </h2>
    {
      description && (
        <p data-reveal="up" class="max-w-md text-lg leading-snug text-muted lg:col-span-4 lg:justify-self-end">
          {description}
        </p>
      )
    }
  </div>
</header>
