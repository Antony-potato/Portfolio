---
interface Props {
  /** Ya no se muestra (v2.1 quitó la numeración de secciones); se acepta por compatibilidad. */
  index?: string;
  label: string;
  title: string;
  description?: string;
  class?: string;
}

const { label, title, description, class: className = "" } = Astro.props;
---

<header class={className}>
  <div class="eyebrow flex items-center gap-4">
    <span>{label}</span>
    <span data-line class="h-px flex-1 bg-line"></span>
  </div>
  <div class="mt-6 grid items-end gap-4 md:mt-8 lg:grid-cols-12 lg:gap-6">
    <h2 data-reveal="lines" class="text-[clamp(2rem,4.5vw,4rem)] leading-[0.95] tracking-[-0.045em] lg:col-span-7">
      {title}
    </h2>
    {
      description && (
        <p data-reveal="up" class="max-w-md text-lg leading-snug text-muted lg:col-span-5 lg:justify-self-end">
          {description}
        </p>
      )
    }
  </div>
</header>
