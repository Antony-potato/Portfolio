---
interface Props {
  label: string;
  title: string;
  description?: string;
  class?: string;
}

const { label, title, description, class: className = "" } = Astro.props;
---

<header class={className}>
  <div class="eyebrow flex items-center gap-4">
    <span>{label}</span>
    <span data-line class="h-px flex-1 bg-line"></span>
  </div>
  <div class="mt-6 grid items-end gap-6 md:mt-8 lg:grid-cols-12">
    <h2
      data-reveal="lines"
      class="text-[clamp(2rem,4.5vw,4rem)] leading-[0.95] tracking-[-0.045em] lg:col-span-8"
    >
      {title}
    </h2>
    {
      description && (
        <p data-reveal="up" class="max-w-md leading-snug text-muted lg:col-span-4 lg:justify-self-end">
          {description}
        </p>
      )
    }
  </div>
</header>
