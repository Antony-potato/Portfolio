---
type Variant = "primary" | "secondary";
type Size = "sm" | "md" | "lg";

interface Props {
  href?: string | URL;
  variant?: Variant;
  size?: Size;
  type?: "button" | "submit" | "reset";
  external?: boolean;
  /** Atracción magnética hacia el cursor (solo con mouse). */
  magnetic?: boolean;
  /** Texto que rueda en hover. Desactivar si el JS cambia el label. */
  roll?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  external = false,
  magnetic = false,
  roll = true,
  class: className = "",
  ariaLabel,
} = Astro.props;

const label = await Astro.slots.render("default");

const variants: Record<Variant, string> = {
  primary: "bg-accent text-ink-950",
  secondary: "border border-line text-fg",
};

const sizes: Record<Size, string> = {
  sm: "h-9 px-4 text-sm gap-2",
  md: "h-12 px-6 text-[0.9375rem] gap-2.5",
  lg: "h-14 px-7 text-base gap-3",
};

const cls = [
  "btn-fill inline-flex items-center justify-center rounded-full font-medium whitespace-nowrap select-none transition-colors duration-300",
  "disabled:pointer-events-none disabled:opacity-60",
  variants[variant],
  sizes[size],
  className,
].join(" ");

const Tag = href ? "a" : "button";
const attrs = href
  ? { href, target: external ? "_blank" : undefined, rel: external ? "noopener noreferrer" : undefined }
  : { type };
---

<Tag {...attrs} class={cls} aria-label={ariaLabel} data-magnetic={magnetic ? "0.3" : undefined}>
  {
    roll ? (
      <span class="roll">
        <span set:html={label} />
        <span aria-hidden="true" set:html={label} />
      </span>
    ) : (
      <Fragment set:html={label} />
    )
  }
</Tag>
