---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  index: number;
  total: number;
  title: string;
  summary: string;
  category: string;
  role: string;
  year: number;
  client?: string | undefined;
  stack: string[];
  cover: ImageMetadata;
  labels: { role: string; client: string; stack: string; view: string };
}

const { href, index, total, title, summary, category, role, year, client, stack, cover, labels } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const cell = "flex flex-col gap-1 border-line py-3";
---

<a
  href={href}
  class="group relative grid origin-top overflow-hidden rounded-md border border-line bg-surface transition-colors duration-500 hover:border-fg lg:h-[min(74vh,44rem)] lg:grid-cols-12 lg:grid-rows-[auto_1fr]"
>
  <div class="flex items-center justify-between gap-4 border-b border-line px-4 py-3 font-mono text-[0.6875rem] uppercase tracking-[0.08em] md:px-6 lg:col-span-12">
    <span>{pad(index)} <span class="text-muted">/ {pad(total)}</span></span>
    <span class="text-muted">{category} — {year}</span>
    <span class="grid size-7 place-items-center rounded-full border border-line transition-colors duration-500 group-hover:border-accent group-hover:bg-accent group-hover:text-ink-950">
      <Icon name="lucide:arrow-up-right" class="size-3.5 transition-transform duration-500 group-hover:rotate-45" aria-hidden="true" />
    </span>
  </div>

  <div class="relative aspect-[16/10] overflow-hidden bg-bg lg:col-span-7 lg:col-start-6 lg:row-start-2 lg:aspect-auto lg:border-l lg:border-line">
    <Picture
      src={cover}
      alt=""
      formats={["avif", "webp"]}
      widths={[480, 800, 1200, 1600]}
      sizes="(min-width: 1024px) 58vw, 100vw"
      loading="lazy"
      class="absolute inset-0 size-full object-cover transition-transform duration-[1400ms] ease-(--ease-out-expo) group-hover:scale-[1.045]"
    />
  </div>

  <div class="flex flex-col gap-5 p-4 md:p-6 lg:col-span-5 lg:col-start-1 lg:row-start-2 lg:p-8">
    <h3 class="text-[clamp(2.25rem,4.4vw,4.75rem)] leading-[0.9] tracking-[-0.055em]">{title}</h3>
    <p class="line-clamp-2 max-w-md text-muted md:line-clamp-3">{summary}</p>

    <dl class="mt-auto grid grid-cols-2 border-t border-line text-sm">
      <div class={`${cell} border-r pr-3`}>
        <dt class="eyebrow">{labels.role}</dt>
        <dd>{role}</dd>
      </div>
      <div class={`${cell} pl-3`}>
        <dt class="eyebrow">{labels.client}</dt>
        <dd>{client ?? "—"}</dd>
      </div>
      <div class={`${cell} col-span-2 border-t`}>
        <dt class="eyebrow">{labels.stack}</dt>
        <dd class="truncate">{stack.slice(0, 3).join(" · ")}{stack.length > 3 && <span class="text-muted"> +{stack.length - 3}</span>}</dd>
      </div>
    </dl>

    <span class="inline-flex items-center gap-2 text-sm font-medium">
      <span class="roll">
        <span>{labels.view}</span>
        <span aria-hidden="true">{labels.view}</span>
      </span>
      <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true" />
    </span>
  </div>

  <div data-shade class="pointer-events-none absolute inset-0 bg-ink-950 opacity-0" aria-hidden="true"></div>
</a>
