---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  title: string;
  summary: string;
  category: string;
  year: number;
  client?: string | undefined;
  cover: ImageMetadata;
}

const { href, title, summary, category, year, client, cover } = Astro.props;
---

<a href={href} class="group flex flex-col gap-4">
  <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-surface sm:aspect-[16/11]">
    <Picture
      src={cover}
      alt=""
      formats={["avif", "webp"]}
      widths={[480, 800, 1200]}
      sizes="(min-width: 640px) 60vw, 85vw"
      loading="lazy"
      class="absolute inset-0 size-full object-cover transition-transform duration-[1400ms] ease-(--ease-out-expo) group-hover:scale-[1.045]"
    />
  </div>
  <div class="flex items-center justify-between gap-4 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-muted">
    <span>{category} · {year}{client && ` · ${client}`}</span>
    <Icon name="lucide:arrow-up-right" class="size-3.5 shrink-0 transition-transform duration-500 group-hover:rotate-45" aria-hidden="true" />
  </div>
  <h3 class="text-[clamp(1.75rem,6vw,2.5rem)] leading-[0.95] tracking-[-0.05em]">{title}</h3>
  <p class="line-clamp-2 text-muted">{summary}</p>
</a>
