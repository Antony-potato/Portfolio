---
import { Icon } from "astro-icon/components";
import SectionTitle from "../ui/SectionTitle.astro";
import { useTranslations, type Lang } from "~/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface Tech {
  name: string;
  icon: string;
}

type GroupKey = "stack.frontend" | "stack.data" | "stack.infra" | "stack.also";

// Los tres primeros grupos están respaldados por proyectos publicados en este sitio.
// "stack.also" es experiencia académica / de práctica y se muestra atenuada.
const groups: { titleKey: GroupKey; items: Tech[]; muted?: boolean }[] = [
  {
    titleKey: "stack.frontend",
    items: [
      { name: "Astro", icon: "simple-icons:astro" },
      { name: "Next.js", icon: "simple-icons:nextdotjs" },
      { name: "React 19", icon: "simple-icons:react" },
      { name: "TypeScript", icon: "simple-icons:typescript" },
      { name: "Tailwind CSS", icon: "simple-icons:tailwindcss" },
      { name: "Web Components", icon: "simple-icons:webcomponentsdotorg" },
    ],
  },
  {
    titleKey: "stack.data",
    items: [
      { name: "Firebase · Firestore", icon: "simple-icons:firebase" },
      { name: "Google Sheets · Apps Script", icon: "simple-icons:googlesheets" },
      { name: "Web Push · FCM", icon: "lucide:bell-ring" },
      { name: "AWS S3", icon: "simple-icons:amazonaws" },
    ],
  },
  {
    titleKey: "stack.infra",
    items: [
      { name: "Vercel", icon: "simple-icons:vercel" },
      { name: "CI/CD", icon: "lucide:git-pull-request-arrow" },
      { name: "Git · GitHub", icon: "simple-icons:github" },
    ],
  },
  {
    titleKey: "stack.also",
    muted: true,
    items: [
      { name: "Vue 3", icon: "simple-icons:vuedotjs" },
      { name: "Laravel · PHP", icon: "simple-icons:laravel" },
      { name: "Spring Boot · Java", icon: "simple-icons:springboot" },
      { name: "Node.js · Express", icon: "simple-icons:nodedotjs" },
      { name: "Docker", icon: "simple-icons:docker" },
      { name: "Kubernetes", icon: "simple-icons:kubernetes" },
    ],
  },
];
---

<section id="stack" class="wrapper py-24 md:py-32">
  <SectionTitle eyebrow={t("stack.eyebrow")} title={t("stack.title")} class="reveal mb-16" />

  <div class="grid gap-px bg-ink-300 dark:bg-ink-700 border border-ink-300 dark:border-ink-700 md:grid-cols-2 lg:grid-cols-4">
    {
      groups.map((g) => (
        <div class:list={["bg-ink-50 dark:bg-ink-950 p-6 flex flex-col gap-4", g.muted && "text-ink-500 dark:text-ink-400"]}>
          <div>
            <p class="eyebrow">// {t(g.titleKey)}</p>
            {g.muted && <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">{t("stack.also.note")}</p>}
          </div>
          <ul class="flex flex-col gap-2">
            {g.items.map((tech) => (
              <li class="flex items-center gap-3 font-mono text-sm">
                <Icon name={tech.icon} class="size-4 text-ink-500 dark:text-ink-400 shrink-0" />
                <span>{tech.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
