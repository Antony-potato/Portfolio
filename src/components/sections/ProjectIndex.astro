---
import { Picture, getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import PageHeader from "../ui/PageHeader.astro";
import { useTranslations, getLocalizedPath, type Lang } from "~/i18n/utils";
import { getProjects, projectSlug } from "~/lib/projects";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = lang === "es" ? "/proyectos" : "/projects";
const projects = await getProjects(lang);
// La preview flotante cambia de src en JS: necesita una URL ya optimizada
const previews = await Promise.all(projects.map((p) => getImage({ src: p.data.cover, width: 900, format: "webp" })));
const pad = (n: number) => String(n).padStart(2, "0");
---

<PageHeader
  index="02"
  label={t("projects.label")}
  title={t("projects.index")}
  sup={`(${pad(projects.length)})`}
  description={t("projects.subtitle")}
/>

<section class="wrapper pt-12 pb-24 md:pt-20 md:pb-40">
  <div class="eyebrow hidden grid-cols-12 gap-6 pb-3 md:grid">
    <span class="col-span-1">#</span>
    <span class="col-span-5">{t("projects.index")}</span>
    <span class="col-span-3">{t("projects.category")} — {t("projects.client")}</span>
    <span class="col-span-2">{t("projects.year")}</span>
  </div>

  <ol data-hover-list class="border-t border-line">
    {
      projects.map((p, i) => (
        <li>
          <a
            href={getLocalizedPath(lang, `${base}/${projectSlug(p)}`)}
            data-cover={previews[i]?.src}
            class="group relative isolate grid grid-cols-[auto_1fr_auto] items-center gap-x-4 gap-y-4 border-b border-line py-6 md:grid-cols-12 md:gap-6 md:py-9"
          >
            <span class="absolute inset-0 -z-10 origin-bottom scale-y-0 bg-surface transition-transform duration-700 ease-(--ease-out-expo) group-hover:scale-y-100" aria-hidden="true" />
            <Picture
              src={p.data.cover}
              alt=""
              formats={["avif", "webp"]}
              widths={[400, 800]}
              sizes="100vw"
              loading="lazy"
              pictureAttributes={{ class: "col-span-3 md:hidden" }}
              class="aspect-[16/10] w-full rounded-md object-cover"
            />
            <span class="font-mono text-xs text-muted md:col-span-1">{pad(i + 1)}</span>
            <span class="text-[clamp(2.25rem,6vw,5.75rem)] leading-[0.9] font-extrabold tracking-[-0.055em] transition-transform duration-700 ease-(--ease-out-expo) md:col-span-5 md:group-hover:translate-x-4">
              {p.data.title}
            </span>
            <span class="hidden text-muted md:col-span-3 md:block">
              <span class="uppercase">{p.data.category}</span> — {p.data.client ?? "—"}
            </span>
            <span class="hidden font-mono text-sm tabular-nums md:col-span-2 md:block">{p.data.year}</span>
            <span class="grid size-10 place-items-center justify-self-end rounded-full border border-line transition-colors duration-500 group-hover:border-accent group-hover:bg-accent group-hover:text-ink-950 md:col-span-1">
              <Icon name="lucide:arrow-up-right" class="size-4 transition-transform duration-500 group-hover:rotate-45" aria-hidden="true" />
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <!-- Preview flotante (solo mouse, ver animations.ts → pointerFx) -->
  <div
    data-hover-preview
    class="pointer-events-none fixed top-0 left-0 z-40 hidden w-[min(28rem,32vw)] -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-md md:block"
    style="opacity:0;transform:scale(.8)"
    aria-hidden="true"
  >
    <img src={previews[0]?.src} alt="" class="aspect-[16/10] w-full object-cover" />
  </div>
</section>
