---
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import SplitTitle from "~/components/ui/SplitTitle.astro";
import { useTranslations, getLocalizedPath, type Lang } from "~/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projectsPath = getLocalizedPath(lang, lang === "es" ? "/proyectos" : "/projects");
---

<section data-hero class="relative isolate flex min-h-svh flex-col overflow-clip">
  <!-- Metaballs con dithering 1-bit (ver lib/hero-gl.ts). Tenue y desvanecido hacia abajo (global.css). -->
  <div data-gl-wrap class="absolute inset-0 -z-10" aria-hidden="true">
    <canvas data-gl class="pixelated size-full"></canvas>
  </div>

  <div data-hero-inner class="wrapper flex flex-1 flex-col pt-[calc(var(--nav-h)+1.25rem)] pb-10 md:pb-14">
    <div class="flex justify-end">
      <p data-intro-up style="--d:0" class="tag bg-bg">
        <span class="pulse-dot"></span>
        {t("hero.spec.status.value")}
      </p>
    </div>

    <div class="mt-auto grid gap-6 pt-10 lg:grid-cols-12 lg:items-end lg:gap-8">
      <p
        data-intro-up
        style="--d:1"
        class="max-w-xl text-[clamp(1.25rem,2vw,1.75rem)] leading-[1.35] font-medium tracking-[-0.015em] text-balance lg:col-span-6 lg:col-start-7"
      >
        {t("hero.title")}
      </p>
      <div data-intro-up style="--d:2" class="lg:col-span-6 lg:col-start-7 lg:-mt-2">
        <Button href={projectsPath} size="lg" magnetic>
          {t("hero.cta.primary")}
          <Icon name="lucide:arrow-down-right" class="size-4" aria-hidden="true" />
        </Button>
      </div>
    </div>

    <h1 class="mt-8 -ml-[0.05em] text-[clamp(4rem,min(20vw,31svh),23rem)] leading-[0.8] font-extrabold tracking-[-0.065em] md:mt-6">
      <span class="block"><SplitTitle text="Antonio" /></span>
      <span class="block whitespace-nowrap"><SplitTitle text="Cortazar" offset={7} /><span class="hero-cursor" aria-hidden="true"></span></span>
      <span class="sr-only">Antonio Cortazar — {t("hero.role")}</span>
    </h1>
  </div>
</section>

<style>
  .hero-cursor {
    display: inline-block;
    width: 0.3em;
    height: 0.62em;
    margin-left: 0.08em;
    background: var(--color-accent-500);
    animation: blink 1.1s steps(1) infinite;
  }
</style>
