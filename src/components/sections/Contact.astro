---
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import { useTranslations, type Lang } from "~/i18n/utils";
import { EMAIL, whatsappUrl } from "~/lib/contact";

interface Props {
  lang: Lang;
  /** h1 + animación de intro cuando la sección abre la página (/contacto) */
  as?: "h1" | "h2";
}

const { lang, as: Heading = "h2" } = Astro.props;
const t = useTranslations(lang);
const isPage = Heading === "h1";

// Google Apps Script web app URL. Define PUBLIC_CONTACT_SHEET_URL en tu .env
const endpoint = import.meta.env.PUBLIC_CONTACT_SHEET_URL ?? "";

const channels = [
  { label: "LinkedIn", href: "https://linkedin.com/in/antoniocortazar" },
  { label: "GitHub", href: "https://github.com/Antony-potato" },
];

const fields = [
  { id: "cf-name", name: "name", type: "text" as const, autocomplete: "name", label: t("contact.form.name"), placeholder: t("contact.form.name.placeholder") },
  { id: "cf-email", name: "email", type: "email" as const, autocomplete: "email", label: t("contact.form.email"), placeholder: t("contact.form.email.placeholder") },
];
const labelClass = "font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-muted";
const inputClass =
  "w-full bg-transparent text-xl tracking-[-0.01em] outline-none placeholder:text-muted/60 md:text-2xl";
---

<section
  id="contact"
  data-hero={isPage ? "" : undefined}
  class:list={["wrapper pb-16 md:pb-24", isPage ? "pt-[calc(var(--nav-h)+3rem)] md:pt-[calc(var(--nav-h)+5rem)]" : "pt-16 md:pt-24"]}
>
  <div data-intro={isPage ? "" : undefined} class="eyebrow flex items-center gap-4">
    <span class="text-fg">06</span>
    <span data-line={isPage ? undefined : ""} data-intro-line={isPage ? "" : undefined} class="h-px flex-1 bg-line"></span>
    <span>{t("contact.label")}</span>
  </div>

  <Heading
    data-reveal={isPage ? undefined : "lines"}
    data-intro={isPage ? "" : undefined}
    class="mt-8 max-w-[14ch] text-[clamp(3.25rem,10.5vw,11rem)] leading-[0.84] font-extrabold tracking-[-0.065em] md:mt-10"
  >
    {isPage ? <span data-hero-line class="block">{t("contact.title")}</span> : t("contact.title")}
  </Heading>

  <div class="mt-12 grid gap-14 md:mt-16 lg:grid-cols-12 lg:gap-6">
    <div class="flex flex-col gap-10 lg:col-span-5" data-reveal="up">
      <p class="max-w-md text-xl leading-snug text-muted">{t("contact.body")}</p>

      <a
        href={`mailto:${EMAIL}`}
        class="group flex w-fit items-center gap-3 text-[clamp(1.35rem,2.4vw,2.25rem)] font-semibold tracking-[-0.035em]"
      >
        <span class="link-line">{EMAIL}</span>
        <Icon name="lucide:arrow-up-right" class="size-[0.8em] text-accent transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true" />
      </a>

      <div>
        <Button href={whatsappUrl(t("whatsapp.message"))} size="lg" external magnetic>
          <Icon name="simple-icons:whatsapp" class="size-4" aria-hidden="true" />
          {t("whatsapp.cta")}
        </Button>
      </div>

      <ul class="border-t border-line">
        {
          channels.map((c) => (
            <li>
              <a
                href={c.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between border-b border-line py-4 font-medium"
              >
                <span class="transition-transform duration-500 ease-(--ease-out-expo) group-hover:translate-x-2">{c.label}</span>
                <Icon name="lucide:arrow-up-right" class="size-4 text-muted transition-colors group-hover:text-accent" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-6 lg:col-start-7" data-contact data-reveal="up">
      <form
        id="contact-form"
        class="relative"
        data-endpoint={endpoint}
        data-whatsapp={whatsappUrl()}
        data-sending={t("contact.form.sending")}
        data-error={t("contact.form.error")}
        novalidate
      >
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>
            No llenes esto
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="border-t border-line">
          {
            fields.map((f, i) => (
              <div class="field grid gap-2 border-b border-line py-5">
                <label class={labelClass} for={f.id}>
                  0{i + 1} — {f.label}
                </label>
                <input
                  id={f.id}
                  name={f.name}
                  type={f.type}
                  required
                  autocomplete={f.autocomplete}
                  placeholder={f.placeholder}
                  class={inputClass}
                />
              </div>
            ))
          }
          <div class="field grid gap-2 border-b border-line py-5">
            <label class={labelClass} for="cf-message">03 — {t("contact.form.message")}</label>
            <textarea
              id="cf-message"
              name="message"
              rows="4"
              required
              placeholder={t("contact.form.message.placeholder")}
              class={`${inputClass} resize-y`}></textarea>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button type="submit" size="lg" roll={false}>
            <span data-btn-label>{t("contact.form.send")}</span>
            <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
          </Button>
          <p
            data-form-status
            role="status"
            aria-live="polite"
            class="text-sm text-muted data-[state=error]:text-danger"
          >
          </p>
        </div>
      </form>

      <div
        data-form-success
        hidden
        tabindex="-1"
        role="status"
        aria-live="polite"
        class="contact-success flex min-h-[26rem] flex-col items-start justify-center gap-6 rounded-md border border-line bg-surface p-8 focus:outline-none md:p-12"
      >
        <svg class="size-16 text-accent" viewBox="0 0 52 52" fill="none" aria-hidden="true">
          <circle class="contact-success__circle" cx="26" cy="26" r="24" stroke="currentColor" stroke-width="2"></circle>
          <path class="contact-success__check" d="M15 27l7 7 15-15" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <div class="contact-success__text flex flex-col gap-2">
          <p class="font-display text-4xl leading-none font-extrabold tracking-[-0.04em]">{t("contact.form.success.title")}</p>
          <p class="text-lg text-muted">{t("contact.form.success")}</p>
        </div>
        <div class="contact-success__text">
          <Button type="button" variant="secondary" class="js-contact-again">
            {t("contact.form.again")}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Foco visible: la línea inferior se vuelve naranja y más gruesa */
  .field {
    transition: box-shadow 400ms var(--ease-out-expo);
  }
  .field:focus-within {
    box-shadow: inset 0 -2px 0 var(--color-accent-500);
  }

  .contact-success:not([hidden]) {
    animation: success-in 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .contact-success:not([hidden]) .contact-success__circle {
    stroke-dasharray: 151;
    stroke-dashoffset: 151;
    animation: success-draw 600ms ease-out 150ms forwards;
  }
  .contact-success:not([hidden]) .contact-success__check {
    stroke-dasharray: 36;
    stroke-dashoffset: 36;
    animation: success-draw 350ms ease-out 650ms forwards;
  }
  .contact-success:not([hidden]) .contact-success__text {
    animation: success-in 500ms cubic-bezier(0.16, 1, 0.3, 1) 500ms both;
  }

  @keyframes success-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes success-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-success:not([hidden]),
    .contact-success:not([hidden]) .contact-success__circle,
    .contact-success:not([hidden]) .contact-success__check,
    .contact-success:not([hidden]) .contact-success__text {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  // Con <ClientRouter /> los <script> solo corren una vez: hay que (re)enganchar
  // el formulario en cada navegación, si no el navegador hace un submit nativo
  // que recarga la página y la manda hasta arriba.
  function initContactForm() {
    const root = document.querySelector<HTMLElement>("[data-contact]");
    const form = root?.querySelector<HTMLFormElement>("#contact-form");
    const success = root?.querySelector<HTMLElement>("[data-form-success]");
    if (!root || !form || !success || form.dataset.bound) return;
    form.dataset.bound = "true";

    const endpoint = form.dataset.endpoint ?? "";
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const label = form.querySelector<HTMLElement>("[data-btn-label]");
    const idleLabel = label?.textContent ?? "";

    const setStatus = (text: string, state: "" | "pending" | "error") => {
      if (!status) return;
      status.textContent = text;
      if (state) status.dataset.state = state;
      else delete status.dataset.state;
    };

    const showSuccess = () => {
      form.reset();
      setStatus("", "");
      form.hidden = true;
      success.hidden = false;
      success.focus({ preventScroll: true });
    };

    success.querySelector(".js-contact-again")?.addEventListener("click", () => {
      success.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>("#cf-name")?.focus();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      // Honeypot: si está lleno, es un bot. Fingimos éxito sin enviar.
      const honeypot = form.elements.namedItem("_gotcha") as HTMLInputElement | null;
      if (honeypot?.value) {
        showSuccess();
        return;
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Sin endpoint configurado: armamos el mensaje y lo mandamos por WhatsApp.
      if (!endpoint) {
        const data = new FormData(form);
        const text = `Hola Antonio, soy ${data.get("name")} (${data.get("email")}).\n\n${data.get("message")}`;
        window.open(`${form.dataset.whatsapp}?text=${encodeURIComponent(text)}`, "_blank", "noopener");
        showSuccess();
        return;
      }

      if (submit) submit.disabled = true;
      if (label) label.textContent = form.dataset.sending ?? idleLabel;
      setStatus(form.dataset.sending ?? "", "pending");

      try {
        await fetch(endpoint, {
          method: "POST",
          mode: "no-cors",
          body: new FormData(form),
        });
        showSuccess();
      } catch {
        setStatus(form.dataset.error ?? "", "error");
      } finally {
        if (submit) submit.disabled = false;
        if (label) label.textContent = idleLabel;
      }
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
</script>
