---
import { Icon } from "astro-icon/components";
import SectionTitle from "../ui/SectionTitle.astro";
import Button from "../ui/Button.astro";
import { useTranslations, type Lang } from "~/i18n/utils";
import { EMAIL, whatsappUrl } from "~/lib/contact";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Google Apps Script web app URL. Define PUBLIC_CONTACT_SHEET_URL en tu .env
const endpoint = import.meta.env.PUBLIC_CONTACT_SHEET_URL ?? "";

const waHref = whatsappUrl(t("whatsapp.message"));

const channels = [
  { icon: "lucide:mail", label: t("contact.email"), href: `mailto:${EMAIL}` },
  { icon: "simple-icons:linkedin", label: t("contact.linkedin"), href: "https://linkedin.com/in/antoniocortazar" },
  { icon: "simple-icons:github", label: t("contact.github"), href: "https://github.com/Antony-potato" },
];

const fieldClass =
  "w-full border border-ink-300 dark:border-ink-700 bg-ink-50 dark:bg-ink-950 px-4 py-3 text-base text-ink-950 dark:text-ink-100 placeholder:text-ink-400 dark:placeholder:text-ink-500 transition-colors focus:outline-none focus:border-accent-500 focus-visible:outline-2 focus-visible:outline-accent-500 focus-visible:outline-offset-0";
const labelClass = "font-mono text-xs uppercase tracking-wider text-ink-500 dark:text-ink-400";
---

<section id="contact" class="wrapper py-24 md:py-32">
  <div class="grid gap-16 lg:grid-cols-12">
    <div class="lg:col-span-5 reveal">
      <SectionTitle eyebrow={t("contact.eyebrow")} title={t("contact.title")} />
      <p class="mt-8 text-lg text-ink-700 dark:text-ink-300 max-w-xl">{t("contact.body")}</p>

      <Button href={waHref} variant="primary" size="lg" external class="mt-8">
        <Icon name="simple-icons:whatsapp" class="size-5" aria-hidden="true" />
        {t("whatsapp.cta")}
      </Button>

      <ul class="mt-10 grid gap-3" data-stagger>
        {
          channels.map((c) => (
            <li data-stagger-child>
              <a
                href={c.href}
                target={c.href.startsWith("http") ? "_blank" : undefined}
                rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="group inline-flex items-center gap-3 text-ink-700 dark:text-ink-300 hover:text-accent-500 dark:hover:text-accent-400 transition-colors"
              >
                <Icon name={c.icon} class="size-5" />
                <span class="font-display font-semibold">{c.label}</span>
                <Icon
                  name="lucide:arrow-up-right"
                  class="size-4 transition-transform duration-300 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-7 reveal" data-contact>
      <form
        id="contact-form"
        class="grid gap-5"
        data-endpoint={endpoint}
        data-whatsapp={whatsappUrl()}
        data-sending={t("contact.form.sending")}
        data-error={t("contact.form.error")}
        novalidate
      >
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>
            No llenes esto
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="grid gap-2">
          <label class={labelClass} for="cf-name">{t("contact.form.name")}</label>
          <input
            id="cf-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder={t("contact.form.name.placeholder")}
            class={fieldClass}
          />
        </div>

        <div class="grid gap-2">
          <label class={labelClass} for="cf-email">{t("contact.form.email")}</label>
          <input
            id="cf-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={t("contact.form.email.placeholder")}
            class={fieldClass}
          />
        </div>

        <div class="grid gap-2">
          <label class={labelClass} for="cf-message">{t("contact.form.message")}</label>
          <textarea
            id="cf-message"
            name="message"
            rows="5"
            required
            placeholder={t("contact.form.message.placeholder")}
            class={`${fieldClass} resize-y`}></textarea>
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button type="submit" variant="primary" size="lg">
            <span data-btn-label>{t("contact.form.send")}</span>
            <span aria-hidden="true">→</span>
          </Button>
          <p
            data-form-status
            role="status"
            aria-live="polite"
            class="text-sm text-ink-500 dark:text-ink-400 data-[state=error]:text-danger"
          >
          </p>
        </div>
      </form>

      <div
        data-form-success
        hidden
        tabindex="-1"
        role="status"
        aria-live="polite"
        class="contact-success flex min-h-[26rem] flex-col items-start justify-center gap-6 border border-ink-300 dark:border-ink-700 p-8 md:p-12 focus:outline-none"
      >
        <svg class="size-16 text-accent-500" viewBox="0 0 52 52" fill="none" aria-hidden="true">
          <circle class="contact-success__circle" cx="26" cy="26" r="24" stroke="currentColor" stroke-width="2"></circle>
          <path class="contact-success__check" d="M15 27l7 7 15-15" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <div class="contact-success__text flex flex-col gap-2">
          <p class="font-display text-3xl font-bold leading-tight">{t("contact.form.success.title")}</p>
          <p class="text-lg text-ink-700 dark:text-ink-300">{t("contact.form.success")}</p>
        </div>
        <div class="contact-success__text">
          <Button type="button" variant="secondary" size="md" class="js-contact-again">
            {t("contact.form.again")}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-success:not([hidden]) {
    animation: success-in 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .contact-success:not([hidden]) .contact-success__circle {
    stroke-dasharray: 151;
    stroke-dashoffset: 151;
    animation: success-draw 600ms ease-out 150ms forwards;
  }
  .contact-success:not([hidden]) .contact-success__check {
    stroke-dasharray: 36;
    stroke-dashoffset: 36;
    animation: success-draw 350ms ease-out 650ms forwards;
  }
  .contact-success:not([hidden]) .contact-success__text {
    animation: success-in 500ms cubic-bezier(0.16, 1, 0.3, 1) 500ms both;
  }

  @keyframes success-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes success-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-success:not([hidden]),
    .contact-success:not([hidden]) .contact-success__circle,
    .contact-success:not([hidden]) .contact-success__check,
    .contact-success:not([hidden]) .contact-success__text {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  // Con <ClientRouter /> los <script> solo corren una vez: hay que (re)enganchar
  // el formulario en cada navegación, si no el navegador hace un submit nativo
  // que recarga la página y la manda hasta arriba.
  function initContactForm() {
    const root = document.querySelector<HTMLElement>("[data-contact]");
    const form = root?.querySelector<HTMLFormElement>("#contact-form");
    const success = root?.querySelector<HTMLElement>("[data-form-success]");
    if (!root || !form || !success || form.dataset.bound) return;
    form.dataset.bound = "true";

    const endpoint = form.dataset.endpoint ?? "";
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const label = form.querySelector<HTMLElement>("[data-btn-label]");
    const idleLabel = label?.textContent ?? "";

    const setStatus = (text: string, state: "" | "pending" | "error") => {
      if (!status) return;
      status.textContent = text;
      if (state) status.dataset.state = state;
      else delete status.dataset.state;
    };

    const showSuccess = () => {
      form.reset();
      setStatus("", "");
      form.hidden = true;
      success.hidden = false;
      success.focus({ preventScroll: true });
    };

    success.querySelector(".js-contact-again")?.addEventListener("click", () => {
      success.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>("#cf-name")?.focus();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      // Honeypot: si está lleno, es un bot. Fingimos éxito sin enviar.
      const honeypot = form.elements.namedItem("_gotcha") as HTMLInputElement | null;
      if (honeypot?.value) {
        showSuccess();
        return;
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Sin endpoint configurado: armamos el mensaje y lo mandamos por WhatsApp.
      if (!endpoint) {
        const data = new FormData(form);
        const text = `Hola Antonio, soy ${data.get("name")} (${data.get("email")}).\n\n${data.get("message")}`;
        window.open(`${form.dataset.whatsapp}?text=${encodeURIComponent(text)}`, "_blank", "noopener");
        showSuccess();
        return;
      }

      if (submit) submit.disabled = true;
      if (label) label.textContent = form.dataset.sending ?? idleLabel;
      setStatus(form.dataset.sending ?? "", "pending");

      try {
        await fetch(endpoint, {
          method: "POST",
          mode: "no-cors",
          body: new FormData(form),
        });
        showSuccess();
      } catch {
        setStatus(form.dataset.error ?? "", "error");
      } finally {
        if (submit) submit.disabled = false;
        if (label) label.textContent = idleLabel;
      }
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
</script>
