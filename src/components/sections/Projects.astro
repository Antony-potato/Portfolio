---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import SectionTitle from "../ui/SectionTitle.astro";
import ProjectCard from "../ui/ProjectCard.astro";
import { useTranslations, getLocalizedPath, type Lang } from "~/i18n/utils";
import { getProjects, projectSlug } from "~/lib/projects";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projectsBase = lang === "es" ? "/proyectos" : "/projects";
const featured = (await getProjects(lang))
  .filter((p) => p.data.featured)
  .map((p) => ({ ...p.data, href: getLocalizedPath(lang, `${projectsBase}/${projectSlug(p)}`) }));
const pad = (n: number) => String(n).padStart(2, "0");

// Tema del escaparate por proyecto: fondo = color de marca (frontmatter `accent`) y tinta clara u oscura.
// Con tinta clara todo el texto va en blanco puro: sobre el terracota de Aldea Savia es lo único que da AA.
const inks = {
  light: { fg: "#ffffff", muted: "#ffffff", dim: "rgb(255 255 255 / 0.6)", line: "rgb(255 255 255 / 0.3)", surface: "rgb(255 255 255 / 0.12)" },
  dark: { fg: "#0a0a0b", muted: "rgb(10 10 11 / 0.74)", dim: "rgb(10 10 11 / 0.5)", line: "rgb(10 10 11 / 0.2)", surface: "rgb(10 10 11 / 0.08)" },
};
const theme = (p: (typeof featured)[number]) => {
  if (!p.accent) return "";
  const ink = inks[p.accentInk];
  return `--sc-bg:${p.accent};--sc-fg:${ink.fg};--sc-muted:${ink.muted};--sc-dim:${ink.dim};--sc-line:${ink.line};--sc-surface:${ink.surface}`;
};
const meta = (p: (typeof featured)[number]) => [p.category, p.year, p.client].filter(Boolean).join(" · ");
---

<!-- En escritorio no lleva margen arriba: el ancla cae justo donde el escaparate queda fijo -->
<section id="projects" class="py-16 md:py-24 lg:scroll-mt-0 lg:py-0">
  <!-- Móvil y tablet: carrusel horizontal con scroll-snap -->
  <div class="lg:hidden">
    <SectionTitle label={t("projects.label")} title={t("projects.title")} description={t("projects.subtitle")} class="wrapper" />
    <ol class="mt-10 flex snap-x snap-mandatory scroll-px-(--gutter) gap-4 overflow-x-auto px-(--gutter) pb-2 [scrollbar-width:none]">
      {
        featured.map((p) => (
          <li class="w-[82%] shrink-0 snap-start sm:w-[58%]">
            <ProjectCard
              href={p.href}
              title={p.title}
              summary={p.summary}
              category={p.category}
              year={p.year}
              client={p.client}
              cover={p.cover}
            />
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Escritorio: escaparate fijo. El scroll dentro del contenedor elige el proyecto activo (script abajo). -->
  <div data-showcase class="relative hidden lg:block" style={`height: calc(100svh + ${featured.length} * 75svh); --i: 0`}>
    <div data-sc-stage class="sc-theme sc-stage sticky top-0 h-svh bg-bg pt-(--nav-h) pb-6" style={theme(featured[0]!)}>
      <div class="wrapper grid h-full grid-cols-12 gap-6">
        <div class="col-span-5 flex min-h-0 flex-col pt-4">
          <div class="eyebrow flex items-center gap-4">
            <span>{t("projects.label")}</span>
            <span data-line class="h-px flex-1 bg-line"></span>
          </div>
          <h2 class="mt-5 text-[clamp(2rem,3.6vw,3.5rem)] leading-[0.95] tracking-[-0.045em]">{t("projects.title")}</h2>

          <ol class="mt-6 border-t border-line">
            {
              featured.map((p, i) => (
                <li>
                  <button
                    type="button"
                    data-sc-go={i}
                    data-sc-theme={theme(p)}
                    data-sc-ink={p.accent ? p.accentInk : undefined}
                    aria-current={i === 0 ? "true" : "false"}
                    class="sc-item flex w-full items-baseline gap-4 border-b border-line py-2 text-left text-lg font-semibold tracking-[-0.02em]"
                  >
                    <span class="font-mono text-[0.6875rem] font-medium tracking-[0.08em]">{pad(i + 1)}</span>
                    {p.title}
                  </button>
                </li>
              ))
            }
          </ol>

          <div class="mt-6 grid">
            {
              featured.map((p, i) => (
                <div data-sc-detail class:list={["sc-detail flex flex-col gap-3 [grid-area:1/1]", i === 0 && "is-active"]} inert={i !== 0}>
                  <p class="font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-muted">{meta(p)}</p>
                  <p class="line-clamp-3 max-w-md text-muted">{p.summary}</p>
                  <p class="text-sm">{p.stack.slice(0, 4).join(" · ")}</p>
                  <a href={p.href} class="group inline-flex w-fit items-center gap-2 text-sm font-medium">
                    <span class="link-line">{t("projects.view")}</span>
                    <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true" />
                  </a>
                </div>
              ))
            }
          </div>

          <p class="mt-auto flex items-end gap-3 font-display font-bold tracking-[-0.06em] tabular-nums" aria-hidden="true">
            <span class="sc-count text-[min(10vw,20svh)]">
              <span class="sc-digits">{featured.map((_, i) => <span>{pad(i + 1)}</span>)}</span>
            </span>
            <span class="pb-[0.4em] font-mono text-sm font-medium tracking-normal text-muted">/ {pad(featured.length)}</span>
          </p>
        </div>

        <div class="relative col-span-7 overflow-hidden rounded-md bg-surface">
          {
            featured.map((p, i) => (
              <a
                href={p.href}
                data-sc-cover
                class:list={["sc-cover group absolute inset-0 overflow-hidden", i === 0 && "is-active"]}
                inert={i !== 0}
                aria-label={`${t("projects.view")}: ${p.title}`}
              >
                <span data-sc-inner class="absolute inset-0 block">
                  <Picture
                    src={p.cover}
                    alt=""
                    formats={["avif", "webp"]}
                    widths={[800, 1200, 1600]}
                    sizes="58vw"
                    loading={i === 0 ? "eager" : "lazy"}
                    class="size-full object-cover"
                  />
                  <span class="tag absolute bottom-4 left-4 z-10 bg-bg">
                    {t("projects.view")}
                    <Icon name="lucide:arrow-up-right" class="size-3 transition-transform duration-500 group-hover:rotate-45" aria-hidden="true" />
                  </span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  /* Curva de entrada de la referencia: lenta al inicio y al final */
  [data-showcase] {
    --sc-ease: cubic-bezier(0.87, 0, 0.13, 1);
  }

  /* El fondo y la tinta cambian con el proyecto activo (ver .sc-theme en global.css) */
  .sc-stage {
    transition:
      --sc-bg 700ms ease,
      --sc-fg 700ms ease,
      --sc-muted 700ms ease,
      --sc-dim 700ms ease,
      --sc-line 700ms ease,
      --sc-surface 700ms ease;
  }

  .sc-item {
    color: var(--sc-dim, var(--muted));
    transition: color 400ms ease;
  }
  .sc-item:hover,
  .sc-item[aria-current="true"] {
    color: var(--fg);
  }
  .sc-item[aria-current="true"] > span {
    color: var(--accent-ink);
  }

  .sc-detail {
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity 400ms ease,
      transform 400ms ease;
  }
  .sc-detail.is-active {
    opacity: 1;
    transform: none;
    transition:
      opacity 700ms ease 250ms,
      transform 900ms var(--ease-out-expo) 250ms;
  }

  /* Contador: columna de números que rueda hasta el activo */
  .sc-count {
    display: block;
    height: 0.8em;
    overflow: hidden;
    line-height: 0.8;
  }
  .sc-digits {
    display: flex;
    flex-direction: column;
    transform: translateY(calc(var(--i) * -0.8em));
    transition: transform 1.1s var(--sc-ease);
  }

  /* Portadas apiladas. Solo la activa (encima) y la anterior (debajo, mientras termina la revelación)
     se pintan; el resto va con visibility: hidden (no se pinta ni se rasteriza). La revelación es WAAPI
     en el script y solo usa transform (la portada sube y su contenido baja lo mismo: efecto de máscara),
     que va por el compositor: antes con clip-path se repintaba la imagen entera en cada frame.
     Sin reglas que compitan por especificidad (antes [data-dir=up] le ganaba a .is-active y la
     portada se quedaba gris). */
  .sc-cover {
    z-index: 0;
    visibility: hidden;
  }
  .sc-cover.is-prev {
    z-index: 1;
    visibility: visible;
  }
  .sc-cover.is-active {
    z-index: 2;
    visibility: visible;
  }
  /* Paneo leve con el avance dentro del tramo (--p de 0 a 1). --p vive solo en la portada activa
     (ponerlo en todo el escaparate recalculaba estilos de la sección en cada frame) y la imagen va
     en su propia capa para que moverla no la repinte. */
  .sc-cover :global(img) {
    scale: 1.08;
    translate: 0 calc((var(--p, 0.5) - 0.5) * -6%);
  }
  .sc-cover:is(.is-active, .is-prev) :global(img) {
    will-change: translate;
  }
</style>

<script>
  // Escaparate: el avance del scroll dentro de [data-showcase] elige el proyecto activo.
  // Va fuera de animations.ts a propósito: con reduced-motion también cambia de proyecto (solo sin transiciones).
  const EASE = "cubic-bezier(0.87, 0, 0.13, 1)";

  function initShowcase() {
    const root = document.querySelector<HTMLElement>("[data-showcase]");
    if (!root) return () => {};
    const covers = [...root.querySelectorAll<HTMLElement>("[data-sc-cover]")];
    const details = [...root.querySelectorAll<HTMLElement>("[data-sc-detail]")];
    const items = [...root.querySelectorAll<HTMLElement>("[data-sc-go]")];
    const n = covers.length;
    const stage = root.querySelector<HTMLElement>("[data-sc-stage]");
    const nav = document.querySelector<HTMLElement>("[data-nav]");
    let navThemed = false;

    // El nav flota encima del escaparate: mientras lo tapa, toma el mismo tema que el proyecto activo
    const themeNav = (on: boolean) => {
      if (!nav) return;
      const item = items[current];
      const vars = on ? (item?.dataset.scTheme ?? "") : "";
      navThemed = on && vars !== "";
      nav.classList.toggle("sc-theme", navThemed);
      for (const decl of ["--sc-bg", "--sc-fg", "--sc-muted", "--sc-line"]) nav.style.removeProperty(decl);
      if (navThemed) {
        for (const decl of vars.split(";")) {
          const [name, value] = decl.split(":");
          if (name && value && name !== "--sc-dim" && name !== "--sc-surface") nav.style.setProperty(name, value);
        }
        nav.dataset.ink = item?.dataset.scInk ?? "light";
      } else delete nav.dataset.ink;
    };
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let range = root.offsetHeight - innerHeight;
    let current = 0;
    let reveal: Animation | null = null;
    let innerReveal: Animation | null = null;

    // Pide (y decodifica) la portada k si aún no se pidió. Las inactivas están recortadas,
    // así que el lazy-load nativo no las ve nunca.
    const warm = (k: number) => {
      const img = covers[k]?.querySelector("img");
      if (!img || img.loading === "eager") return;
      img.loading = "eager";
      img.decode().catch(() => {});
    };

    const activate = (i: number) => {
      // Respaldo por si el observer no alcanzó: la activa y sus vecinas, ya
      [i, i - 1, i + 1].forEach(warm);
      const down = i > current;
      const prev = covers[current];
      current = i;
      root.style.setProperty("--i", String(i));
      if (stage) stage.style.cssText = items[i]?.dataset.scTheme ?? "";
      if (navThemed) themeNav(true);

      // La nueva entra encima; la anterior se queda visible debajo hasta que termina
      reveal?.cancel();
      covers.forEach((el) => el.classList.remove("is-prev"));
      prev?.classList.add("is-prev");
      for (const list of [covers, details])
        list.forEach((el, k) => {
          el.classList.toggle("is-active", k === i);
          el.inert = k !== i;
        });
      items.forEach((el, k) => el.setAttribute("aria-current", String(k === i)));

      const next = covers[i];
      const inner = next?.querySelector<HTMLElement>("[data-sc-inner]");
      if (!next || !inner || reduced.matches) return prev?.classList.remove("is-prev");
      const from = down ? 100 : -100;
      const opts = { duration: 1100, easing: EASE };
      reveal = next.animate({ transform: [`translateY(${from}%)`, "translateY(0)"] }, opts);
      innerReveal?.cancel();
      innerReveal = inner.animate({ transform: [`translateY(${-from}%)`, "translateY(0)"] }, opts);
      reveal.finished.then(() => prev?.classList.remove("is-prev"), () => {});
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      const r = root.getBoundingClientRect();
      const over = r.height > 0 && r.top <= 30 && r.bottom >= 30; // el escaparate está bajo el nav
      if (over !== navThemed) themeNav(over);
      if (!r.height || r.bottom < 0 || r.top > innerHeight) return; // oculto (móvil) o fuera de vista
      const p = Math.min(1, Math.max(0, -r.top / range)) * n;
      const i = Math.min(n - 1, Math.floor(p));
      if (i !== current) activate(i);
      covers[i]?.style.setProperty("--p", (Math.min(1, p - i)).toFixed(3));
    };
    // Un cálculo por frame como máximo, aunque lleguen varios eventos de scroll
    const onScroll = () => {
      if (!ticking) (ticking = true), requestAnimationFrame(update);
    };
    const onResize = () => {
      range = root.offsetHeight - innerHeight;
      onScroll();
    };

    // Click en la lista: baja (o sube) hasta la mitad del tramo de ese proyecto
    items.forEach((el, k) =>
      el.addEventListener("click", () => {
        const y = root.getBoundingClientRect().top + scrollY + ((k + 0.5) / n) * range;
        if (window.__lenis) window.__lenis.scrollTo(y);
        else scrollTo({ top: y, behavior: reduced.matches ? "auto" : "smooth" });
      }),
    );

    // Las portadas inactivas están recortadas, así que el lazy-load nativo no las pide. Cuando el
    // escaparate se acerca se piden todas y se decodifican antes de mostrarse (si no, la primera
    // revelación de cada una traba el scroll mientras el navegador decodifica la imagen).
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        covers.forEach((_, k) => warm(k));
        io.disconnect();
      },
      { rootMargin: "100% 0px" },
    );
    io.observe(root);

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onResize);
    update();
    return () => {
      io.disconnect();
      themeNav(false);
      reveal?.cancel();
      innerReveal?.cancel();
      removeEventListener("scroll", onScroll);
      removeEventListener("resize", onResize);
    };
  }

  let off = () => {};
  document.addEventListener("astro:page-load", () => (off = initShowcase()));
  document.addEventListener("astro:before-swap", () => off());
</script>
