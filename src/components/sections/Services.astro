---
import { Icon } from "astro-icon/components";
import SectionTitle from "../ui/SectionTitle.astro";
import Button from "../ui/Button.astro";
import { useTranslations, type Lang } from "~/i18n/utils";
import { EMAIL, whatsappUrl } from "~/lib/contact";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  { icon: "lucide:layout-dashboard", titleKey: "services.item.1.title", bodyKey: "services.item.1.body" },
  { icon: "lucide:gauge", titleKey: "services.item.2.title", bodyKey: "services.item.2.body" },
  { icon: "lucide:server", titleKey: "services.item.3.title", bodyKey: "services.item.3.body" },
] as const;
---

<section id="services" class="inverse relative overflow-clip py-16 md:py-24">
  <div class="wrapper">
    <SectionTitle
      index="04"
      label={t("services.label")}
      title={t("services.title")}
      description={t("services.body")}
    />

    <ol class="mt-10 border-t border-line md:mt-16">
      {
        services.map((s, i) => (
          <li class="group grid grid-cols-[auto_1fr] gap-x-6 gap-y-4 border-b border-line py-8 md:grid-cols-12 md:gap-6 md:py-12">
            <span class="font-display text-[clamp(3rem,6vw,6rem)] leading-[0.8] font-extrabold tracking-[-0.06em] text-accent-ink md:col-span-2">
              0{i + 1}
            </span>
            <h3 class="self-end text-[clamp(1.5rem,2.8vw,2.75rem)] leading-[1] tracking-[-0.04em] md:col-span-5 md:self-start">
              {t(s.titleKey)}
            </h3>
            <p class="col-span-2 max-w-md text-muted md:col-span-4 md:col-start-8">{t(s.bodyKey)}</p>
            <span class="hidden size-10 place-items-center justify-self-end rounded-full border border-line transition-colors duration-500 group-hover:border-accent group-hover:bg-accent group-hover:text-ink-950 md:col-span-1 md:grid">
              <Icon name={s.icon} class="size-4" aria-hidden="true" />
            </span>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 flex flex-wrap gap-3 md:mt-12">
      <Button href={`mailto:${EMAIL}?subject=${lang === "es" ? "Cotización" : "Quote"}`} size="lg" magnetic>
        {t("services.cta.secondary")}
        <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
      </Button>
      <Button href={whatsappUrl(t("whatsapp.message"))} variant="secondary" size="lg" external>
        <Icon name="simple-icons:whatsapp" class="size-4" aria-hidden="true" />
        WhatsApp
      </Button>
    </div>
  </div>
</section>
