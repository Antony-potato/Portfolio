---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import portrait from "~/assets/portrait.webp";
import Button from "../ui/Button.astro";
import { cvPath } from "~/lib/cv";
import { certifications } from "~/lib/certifications";
import { useTranslations, type Lang } from "~/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cv = cvPath(lang);
const certs = certifications(lang);

// Solo cifras verificables en el propio sitio
const stats = [
  { value: "05", count: 5, label: t("about.stat.cases") },
  { value: "02", count: 2, label: t("about.stat.clients") },
  { value: String(certs.length), count: certs.length, label: t("about.stat.certs") },
  { value: "C1", label: t("about.stat.english") },
];
---

<section id="about" class="wrapper py-16 md:py-24">
  <div class="eyebrow flex items-center gap-4">
    <span>{t("about.label")}</span>
    <span data-line class="h-px flex-1 bg-line"></span>
  </div>

  <div class="mt-10 grid gap-12 md:mt-14 lg:grid-cols-12 lg:gap-6">
    <div data-clip class="relative aspect-[4/5] overflow-hidden bg-surface lg:col-span-4">
      <Picture
        data-parallax="7"
        src={portrait}
        formats={["avif", "webp"]}
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 33vw, 100vw"
        alt={lang === "es" ? "Antonio Cortazar sentado frente a una galería de arte" : "Antonio Cortazar sitting in front of an art gallery wall"}
        loading="lazy"
        class="absolute inset-0 size-full scale-[1.16] object-cover grayscale contrast-[1.08] transition-[filter] duration-1000 hover:grayscale-0"
      />
    </div>

    <div class="flex flex-col gap-12 lg:col-span-7 lg:col-start-6">
      <div>
        <h2 data-reveal="lines" class="text-[clamp(2rem,4.5vw,4rem)] leading-[0.95] tracking-[-0.045em]">
          {t("about.title")}
        </h2>
        <p data-reveal="up" class="mt-6 max-w-xl text-lg text-muted">{t("about.body")}</p>
        {
          cv && (
            <div data-reveal="up" class="mt-8">
              <Button href={cv} variant="secondary" external>
                <Icon name="lucide:download" class="size-4" aria-hidden="true" />
                {t("cv.download")}
              </Button>
            </div>
          )
        }
      </div>

      <dl class="grid grid-cols-2 border-t border-line sm:grid-cols-4" data-stagger>
        {
          stats.map((s) => (
            <div class="border-b border-line py-5 pr-4">
              <dt class="eyebrow">{s.label}</dt>
              <dd class="mt-3 font-display text-4xl leading-none font-extrabold tracking-[-0.05em] tabular-nums">
                <span data-count={s.count}>{s.value}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <div>
        <h3 class="eyebrow">{t("certs.title")}</h3>
        <ul class="mt-4 grid border-t border-line text-sm sm:grid-cols-2 sm:gap-x-6">
          {
            certs.map((c) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-line py-2.5">
                {c.url === "#" ? (
                  <span>{c.name}</span>
                ) : (
                  <a href={c.url} target="_blank" rel="noopener noreferrer" class="link-line">{c.name}</a>
                )}
                <span class="shrink-0 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-muted">{c.issuer}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
