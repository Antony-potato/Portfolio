---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import portrait from "~/assets/portrait.webp";
import Button from "../ui/Button.astro";
import { cvPath } from "~/lib/cv";
import { getCertifications } from "~/lib/certifications";
import { useTranslations, type Lang } from "~/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const certs = getCertifications(lang);
const cv = cvPath(lang);

// Solo cifras verificables en el propio sitio
const stats = [
  { value: "05", label: t("about.stat.cases") },
  { value: "02", label: t("about.stat.clients") },
  { value: "10", label: t("about.stat.certs") },
  { value: "C1", label: t("about.stat.english") },
];
---

<section id="about" class="wrapper py-16 md:py-24">
  <div class="eyebrow flex items-center gap-4">
    <span>{t("about.label")}</span>
    <span data-line class="h-px flex-1 bg-line"></span>
  </div>

  <div class="mt-8 grid gap-12 md:mt-12 lg:grid-cols-12 lg:gap-6">
    <figure class="group lg:col-span-4">
      <div data-clip class="relative aspect-[4/5] overflow-hidden rounded-md bg-surface">
        <Picture
          src={portrait}
          formats={["avif", "webp"]}
          widths={[400, 640, 900]}
          sizes="(min-width: 1024px) 33vw, 100vw"
          alt={lang === "es" ? "Antonio Cortazar sentado frente a una galería de arte" : "Antonio Cortazar sitting in front of an art gallery wall"}
          loading="lazy"
          class="absolute inset-0 size-full object-cover grayscale contrast-[1.08] transition-[filter] duration-1000 group-hover:grayscale-0"
        />
      </div>
    </figure>

    <div class="flex flex-col gap-10 lg:col-span-7 lg:col-start-6">
      <div>
        <h2 data-reveal="lines" class="text-[clamp(2rem,4.5vw,4rem)] leading-[0.95] tracking-[-0.045em]">
          {t("about.title")}
        </h2>
        <p data-reveal="up" class="mt-6 max-w-xl text-lg text-muted">{t("about.body")}</p>
        {
          cv && (
            <div data-reveal="up" class="mt-6">
              <Button href={cv} variant="secondary" external>
                <Icon name="lucide:download" class="size-4" aria-hidden="true" />
                {t("cv.download")}
              </Button>
            </div>
          )
        }
      </div>

      <dl class="grid grid-cols-2 gap-y-6 border-t border-line pt-6 sm:grid-cols-4" data-stagger>
        {
          stats.map((s) => (
            <div class="flex flex-col-reverse justify-end gap-1">
              <dt class="text-sm text-muted">{s.label}</dt>
              <dd class="text-3xl font-bold tracking-[-0.04em] tabular-nums">{s.value}</dd>
            </div>
          ))
        }
      </dl>

      <div>
        <h3 class="eyebrow">{t("certs.title").replace(/\.$/, "")}</h3>
        <ul class="mt-4 grid border-t border-line sm:grid-cols-2 sm:gap-x-6">
          {
            certs.map((c) => (
              <li class="border-b border-line">
                <a
                  href={c.url}
                  target={c.url.startsWith("http") ? "_blank" : undefined}
                  rel={c.url.startsWith("http") ? "noopener noreferrer" : undefined}
                  title={c.issuer}
                  class="group flex items-center gap-3 py-3 text-sm"
                >
                  <Icon name={c.icon} class="size-4 shrink-0 text-muted transition-colors group-hover:text-accent-ink" aria-hidden="true" />
                  <span class="flex-1">
                    {c.name}
                    <span class="sr-only"> — {c.issuer}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
