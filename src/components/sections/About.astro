---
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import { whatsappUrl } from "~/lib/contact";
import { useTranslations, type Lang } from "~/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Solo cifras verificables en el propio sitio
const stats = [
  { value: "04", count: 4, label: t("about.stat.cases") },
  { value: "02", count: 2, label: t("about.stat.clients") },
  { value: "10", count: 10, label: t("about.stat.certs") },
  { value: "C1", label: t("about.stat.english") },
];
---

<section id="about" class="wrapper py-16 md:py-24">
  <div class="eyebrow flex items-center gap-4">
    <span class="text-fg">01</span>
    <span data-line class="h-px flex-1 bg-line"></span>
    <span>{t("about.label")}</span>
  </div>

  <p
    data-scrub-words
    class="mt-8 text-[clamp(1.75rem,4.1vw,4.25rem)] leading-[1.06] font-semibold tracking-[-0.04em] text-balance md:mt-12 lg:indent-[25%]"
  >
    {t("about.statement")}
  </p>

  <div class="mt-14 grid gap-12 md:mt-20 lg:grid-cols-12 lg:gap-6">
    <figure class="group lg:col-span-5">
      <div data-clip class="relative aspect-[4/5] overflow-hidden bg-surface">
        <img
          data-parallax="7"
          src="/assets/portrait.webp"
          alt={lang === "es" ? "Antonio Cortazar sentado frente a una galería de arte" : "Antonio Cortazar sitting in front of an art gallery wall"}
          width="808"
          height="1080"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 size-full scale-[1.16] object-cover grayscale contrast-[1.08] transition-[filter] duration-1000 group-hover:grayscale-0"
        />
        <span class="crosshair top-3 left-3"></span>
        <span class="crosshair right-3 bottom-3"></span>
      </div>
      <figcaption class="eyebrow mt-3 flex justify-between">
        <span>{t("about.caption")}</span>
        <span>Cancún — 2026</span>
      </figcaption>
    </figure>

    <div class="flex flex-col justify-between gap-16 lg:col-span-6 lg:col-start-7">
      <div>
        <h2 data-reveal="lines" class="text-[clamp(2.25rem,4vw,4rem)] leading-[0.95] tracking-[-0.045em]">
          {t("about.title")}
        </h2>
        <p data-reveal="up" class="mt-6 max-w-xl text-lg text-muted">{t("about.body")}</p>
        <div data-reveal="up" class="mt-8">
          <Button href={whatsappUrl(t("whatsapp.message"))} variant="secondary" external>
            <Icon name="simple-icons:whatsapp" class="size-4" aria-hidden="true" />
            {t("whatsapp.cta")}
          </Button>
        </div>
      </div>

      <dl class="grid grid-cols-2 border-t border-line" data-stagger>
        {
          stats.map((s, i) => (
            <div class:list={["border-b border-line py-6", i % 2 === 0 ? "border-r pr-4" : "pl-6"]}>
              <dt class="eyebrow">{s.label}</dt>
              <dd class="mt-4 font-display text-[clamp(3.25rem,6vw,6rem)] leading-[0.85] font-extrabold tracking-[-0.06em] tabular-nums">
                <span data-count={s.count}>{s.value}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
