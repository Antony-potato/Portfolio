---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { useTranslations, getLocalizedPath, getAlternateLang, getAlternatePath, type Lang } from "~/i18n/utils";
import { languages } from "~/i18n/ui";
import { EMAIL, whatsappUrl } from "~/lib/contact";
import portrait from "~/assets/portrait.webp";
import projectsCover from "~/assets/projects/aldea-savia/cover.webp";
import servicesCover from "~/assets/projects/crzr-tech/cover.webp";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const es = lang === "es";

const home = getLocalizedPath(lang, "/");
// Todo vive en el home: cada enlace del menú lleva a su sección
const section = (id: string) => (home === "/" ? `/#${id}` : `${home}#${id}`);
const contactHref = section("contact");
const preview = async (src: ImageMetadata) => (await getImage({ src, width: 720, format: "webp" })).src;

// Vista previa del menú (escritorio): imagen + 3 palabras por destino. Contacto usa un bloque naranja.
const items = [
  { key: "projects", href: section("projects"), label: t("nav.projects"), img: await preview(projectsCover) },
  { key: "services", href: section("services"), label: t("nav.services"), img: await preview(servicesCover) },
  { key: "about", href: section("about"), label: t("nav.about"), img: await preview(portrait) },
  { key: "contact", href: contactHref, label: t("nav.contact"), img: null },
] as const;
const words = (key: (typeof items)[number]["key"]) => t(`menu.words.${key}`).split(" · ");

// Única página aparte: los casos de estudio (y su índice), que cuentan como "Proyectos"
const inProjects = Astro.url.pathname.startsWith(getLocalizedPath(lang, es ? "/proyectos" : "/projects"));
const isActive = (key: string) => inProjects && key === "projects";
const activeKey = "projects";

const other = getAlternateLang(lang);
const altHref = getAlternatePath(lang, Astro.url.pathname);
const menuBtn =
  "menu-btn flex h-9 items-center gap-2.5 rounded-full border px-3.5 text-sm font-medium lg:absolute lg:top-1/2 lg:left-1/2 lg:-translate-1/2";
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-accent focus:px-4 focus:py-2 focus:text-ink-950"
>
  {t("nav.skip")}
</a>

<header data-nav class="site-nav fixed inset-x-0 top-0 z-50">
  <div class="wrapper relative flex h-(--nav-h) items-center justify-between gap-6">
    <a href={home} class="group flex items-center gap-3" aria-label={`Antonio Cortazar — ${t("nav.home")}`}>
      <img
        src="/logo-ac.svg"
        alt=""
        width="28"
        height="28"
        class="size-7 transition-transform duration-700 ease-(--ease-out-expo) group-hover:rotate-[-12deg] dark:invert"
      />
      <span class="font-mono text-[0.6875rem] uppercase leading-[1.15] tracking-[0.08em]">
        Antonio<br />Cortazar
      </span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={altHref}
        hreflang={other}
        lang={other}
        class="flex h-9 items-center gap-1 px-2 font-mono text-[0.6875rem] uppercase tracking-[0.08em]"
        aria-label={`${languages[other]} — ${other === "en" ? "English" : "Español"}`}
      >
        <span>{languages[lang]}</span>
        <span class="text-muted">/</span>
        <span class="text-muted transition-colors hover:text-fg">{languages[other]}</span>
      </a>

      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-full border border-line transition-colors hover:border-fg"
        aria-label={t("nav.theme")}
      >
        <svg viewBox="0 0 20 20" class="theme-icon size-4" aria-hidden="true">
          <circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M10 1.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
        </svg>
      </button>

      <a
        href={contactHref}
        data-magnetic="0.25"
        class="btn-fill hidden h-9 items-center gap-2 rounded-full bg-fg px-4 text-sm font-medium text-bg sm:inline-flex [--fill:var(--color-accent-500)] [--fill-ink:var(--color-ink-950)]"
      >
        <span>{t("hero.cta.secondary")}</span>
        <span class="size-1.5 rounded-full bg-accent"></span>
      </a>

      <!-- En escritorio va al centro; dentro del menú hay una copia en el mismo lugar que hace de "Cerrar" -->
      <button
        type="button"
        data-menu-open
        aria-haspopup="dialog"
        aria-controls="site-menu"
        class={`${menuBtn} border-line transition-colors hover:border-fg`}
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
        <span class="menu-label"><span>{t("nav.menu")}</span><span aria-hidden="true">{t("nav.close")}</span></span>
      </button>
    </div>
  </div>
</header>

<!-- Menú (referencia: douglus.co). <dialog> nativo = focus trap, Esc e inert gratis.
     Panel claro a la derecha con enlaces gigantes; a la izquierda (escritorio) una vista previa por enlace. -->
<dialog id="site-menu" data-menu class="menu" aria-label={t("nav.menu")}>
  <div data-menu-dim class="menu-dim absolute inset-0 bg-ink-950/90"></div>

  <div class="menu-stage" aria-hidden="true">
    {
      items.map((it) => (
        <div data-menu-preview={it.key} class:list={["menu-preview", it.key === activeKey && "is-active"]}>
          <div class="menu-preview-media">
            {it.img ? <img data-src={it.img} alt="" decoding="async" /> : <span class="block size-full bg-accent" />}
          </div>
          <p class="menu-preview-words">
            {words(it.key).map((w, k) => (
              <span class="block overflow-hidden">
                <span class="block" style={`--k:${k}`}>{w}</span>
              </span>
            ))}
          </p>
        </div>
      ))
    }
  </div>

  <div class="wrapper relative z-20 flex h-(--nav-h) items-center justify-end">
    <button type="button" data-menu-close class={`${menuBtn} border-ink-600 text-ink-100`}>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      <span class="menu-label"><span aria-hidden="true">{t("nav.menu")}</span><span>{t("nav.close")}</span></span>
    </button>
  </div>

  <div class="menu-panel paper">
    <nav aria-label={es ? "Principal" : "Main"}>
      <ul class="flex flex-col gap-[0.6vh]">
        {
          items.map((item, i) => (
            <li>
              <a
                href={item.href}
                data-menu-link={item.key}
                aria-current={isActive(item.key) ? "page" : undefined}
                class="menu-link flex items-center justify-between gap-6"
                style={`--i:${i}`}
              >
                <span class="block overflow-hidden pb-[0.12em]">
                  <span class="menu-link-text block">{item.label}</span>
                </span>
                <span class="menu-dot" aria-hidden="true"></span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-foot mt-auto grid grid-cols-2 gap-6 border-t border-line pt-5 font-mono text-xs uppercase tracking-[0.08em]">
      <div class="flex flex-col gap-2">
        <span class="text-muted">{t("nav.contact")}</span>
        <a href={`mailto:${EMAIL}`} class="link-line w-fit normal-case tracking-normal">{EMAIL}</a>
        <a href={whatsappUrl(t("whatsapp.message"))} target="_blank" rel="noopener noreferrer" class="link-line w-fit">WhatsApp ↗</a>
        <a href="https://linkedin.com/in/antoniocortazar" target="_blank" rel="noopener noreferrer" class="link-line w-fit">LinkedIn ↗</a>
      </div>
      <div class="flex flex-col items-end gap-2 text-right">
        <span class="text-muted">CUN</span>
        <time data-clock class="tabular-nums" aria-label={t("nav.clock")}>--:--:--</time>
        <a href={altHref} hreflang={other} lang={other}>{languages[lang]} / <span class="text-muted">{languages[other]}</span></a>
      </div>
    </div>
  </div>
</dialog>

<style is:global>
  .site-nav {
    view-transition-name: site-nav;
    color: var(--fg);
    transition:
      transform 600ms var(--ease-in-out-quart),
      opacity 900ms ease,
      background-color 400ms ease,
      border-color 400ms ease,
      --sc-bg 700ms ease,
      --sc-fg 700ms ease,
      --sc-muted 700ms ease,
      --sc-line 700ms ease;
    border-bottom: 1px solid transparent;
  }
  .theme-vt .site-nav {
    view-transition-name: none;
  }
  .site-nav[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom-color: var(--line);
  }
  .site-nav[data-hidden] {
    transform: translateY(-100%);
  }
  /* Sobre el escaparate (.sc-theme): el logo es un SVG negro, se invierte según la tinta del proyecto */
  .site-nav[data-ink="light"] img {
    filter: invert(1);
  }
  .site-nav[data-ink="dark"] img {
    filter: none;
  }

  .theme-icon {
    transition: transform 900ms var(--ease-in-out-quart);
  }
  .theme-dark .theme-icon {
    transform: rotate(180deg);
  }

  /* Botón Menú ⇄ Cerrar: dos líneas que se cruzan y etiqueta que rueda */
  .menu-icon {
    position: relative;
    width: 0.875rem;
    height: 0.5rem;
  }
  .menu-icon > span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition:
      top 450ms var(--ease-in-out-quart),
      rotate 450ms var(--ease-in-out-quart) 0ms;
  }
  .menu-icon > span:first-child {
    top: 0;
  }
  .menu-icon > span:last-child {
    top: calc(100% - 1.5px);
  }
  .menu-label {
    display: inline-grid;
    overflow: hidden;
    line-height: 1.2;
  }
  .menu-label > span {
    grid-area: 1 / 1;
    transition: transform 600ms var(--ease-in-out-quart);
  }
  .menu-label > span + span {
    transform: translateY(110%);
  }
  .menu.is-open .menu-icon > span {
    top: calc(50% - 0.75px);
    transition-delay: 0ms, 200ms;
  }
  .menu.is-open .menu-icon > span:first-child {
    rotate: 45deg;
  }
  .menu.is-open .menu-icon > span:last-child {
    rotate: -45deg;
  }
  .menu.is-open .menu-label > span:first-child {
    transform: translateY(-110%);
  }
  .menu.is-open .menu-label > span + span {
    transform: none;
  }

  /* El <dialog> ocupa la pantalla; lo visible se anima con .is-open (transiciones = cierre gratis) */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
    color: var(--color-ink-100);
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu-dim {
    opacity: 0;
    transition: opacity 500ms ease;
  }
  .menu.is-open .menu-dim {
    opacity: 1;
  }

  .menu-panel {
    position: absolute;
    z-index: 10;
    top: calc(var(--nav-h) + 0.5rem);
    right: var(--gutter);
    bottom: var(--gutter);
    left: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1.25rem, 2.4vw, 2.5rem);
    border-radius: 0.375rem;
    background: var(--bg);
    color: var(--fg);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 700ms var(--ease-in-out-quart) 100ms;
  }
  .menu.is-open .menu-panel {
    clip-path: inset(0);
    transition-delay: 0ms;
  }
  @media (min-width: 1024px) {
    .menu-panel {
      top: calc(var(--nav-h) + 1.5rem);
      left: auto;
      width: clamp(30rem, 46vw, 52rem);
    }
  }

  .menu-link {
    font-size: clamp(2.75rem, min(14vw, 9svh), 6rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }
  @media (min-width: 1024px) {
    .menu-link {
      font-size: clamp(2.75rem, min(5.6vw, 9.5svh), 6rem);
    }
  }
  .menu-link-text {
    transform: translateY(110%);
    transition:
      transform 500ms var(--ease-in-out-quart),
      color 300ms ease;
  }
  .menu.is-open .menu-link-text {
    transform: none;
    transition:
      transform 1000ms var(--ease-out-expo) calc(300ms + var(--i) * 60ms),
      color 300ms ease;
  }
  .menu-link:hover .menu-link-text,
  .menu-link:focus-visible .menu-link-text {
    color: var(--accent-ink);
  }
  .menu-dot {
    width: 0.16em;
    aspect-ratio: 1;
    flex: none;
    border-radius: 9999px;
    background: currentColor;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .menu.is-open .menu-link[aria-current="page"] .menu-dot {
    opacity: 1;
    transition-delay: 700ms;
  }
  .menu-foot {
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .menu.is-open .menu-foot {
    opacity: 1;
    transition: opacity 800ms ease 600ms;
  }

  /* Vista previa (solo escritorio): la imagen se abre desde el centro y las palabras entran en 3D */
  .menu-stage {
    display: none;
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .menu-stage {
      position: absolute;
      inset: 0 calc(clamp(30rem, 46vw, 52rem) + var(--gutter)) 0 0;
      display: grid;
      place-items: center;
    }
  }
  .menu-preview {
    grid-area: 1 / 1;
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 350ms ease,
      visibility 0s 350ms;
  }
  .menu.is-open .menu-preview.is-active {
    z-index: 1;
    visibility: visible;
    opacity: 1;
    transition: opacity 0s;
  }
  .menu-preview-media {
    width: min(22vw, 42svh);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    clip-path: inset(50% 0 50% 0);
    transition: clip-path 350ms var(--ease-in-out-quart);
  }
  .menu-preview-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    scale: 1.25;
    transition: scale 1200ms var(--ease-out-expo);
  }
  .menu.is-open .menu-preview.is-active .menu-preview-media {
    clip-path: inset(0);
    transition: clip-path 900ms var(--ease-in-out-quart) 150ms;
  }
  .menu.is-open .menu-preview.is-active img {
    scale: 1;
  }
  .menu-preview-words {
    perspective: 8em;
    font-size: clamp(1.5rem, 2.4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .menu-preview-words > span > span {
    transform: translateY(100%) rotateX(-55deg);
    transform-origin: 50% 100%;
    transition: transform 350ms var(--ease-in-out-quart);
  }
  .menu.is-open .menu-preview.is-active .menu-preview-words > span > span {
    transform: none;
    transition: transform 800ms var(--ease-out-expo) calc(300ms + var(--k) * 70ms);
  }
</style>

<script>
  // Lenis se carga diferido (ver BaseLayout); el menú solo lo pausa si ya existe
  const getLenis = () => window.__lenis;
  const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Reloj — hora local de Cancún (se re-consulta cada tick, sobrevive a las navegaciones)
  const clock = new Intl.DateTimeFormat("es-MX", {
    timeZone: "America/Cancun",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hourCycle: "h23",
  });
  const tickClock = () => {
    const now = clock.format(new Date());
    document.querySelectorAll("[data-clock]").forEach((el) => (el.textContent = now));
  };
  setInterval(tickClock, 1000);

  // Nav: fondo al bajar, se esconde al hacer scroll hacia abajo y vuelve al subir
  let lastY = 0;
  addEventListener(
    "scroll",
    () => {
      const nav = document.querySelector("[data-nav]");
      const y = scrollY;
      nav?.toggleAttribute("data-scrolled", y > 24);
      nav?.toggleAttribute("data-hidden", y > lastY && y > 320);
      lastY = y;
    },
    { passive: true },
  );

  // Tema con revelado circular desde el botón (View Transitions API)
  function toggleTheme(button: HTMLElement) {
    const root = document.documentElement;
    const dark = !root.classList.contains("theme-dark");
    const apply = () => {
      root.classList.toggle("theme-dark", dark);
      button.setAttribute("aria-pressed", String(dark));
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch {}
    };
    if (!document.startViewTransition || reduced()) return apply();

    const r = button.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.classList.add("theme-vt");
    const vt = document.startViewTransition(apply);
    vt.ready.then(() =>
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 900, easing: "cubic-bezier(0.76, 0, 0.24, 1)", pseudoElement: "::view-transition-new(root)" },
      ),
    );
    vt.finished.finally(() => root.classList.remove("theme-vt"));
  }

  document.addEventListener("astro:page-load", () => {
    tickClock();
    lastY = scrollY;

    const toggle = document.querySelector<HTMLElement>("[data-theme-toggle]");
    toggle?.setAttribute("aria-pressed", String(document.documentElement.classList.contains("theme-dark")));
    toggle?.addEventListener("click", () => toggleTheme(toggle));

    const menu = document.querySelector<HTMLDialogElement>("[data-menu]");
    if (!menu) return;
    const previews = [...menu.querySelectorAll<HTMLElement>("[data-menu-preview]")];
    const initial = previews.find((p) => p.classList.contains("is-active"));
    const show = (key: string | undefined) => previews.forEach((p) => p.classList.toggle("is-active", p.dataset.menuPreview === key));

    // Las vistas previas viven dentro del <dialog> cerrado y recortadas con clip-path: el lazy-load
    // nativo no las pide a tiempo. Se cargan al acercar el cursor al botón o al abrir el menú.
    const warm = () =>
      menu.querySelectorAll<HTMLImageElement>("img[data-src]").forEach((img) => {
        img.src = img.dataset.src ?? "";
        img.removeAttribute("data-src");
      });
    const opener = document.querySelector("[data-menu-open]");
    opener?.addEventListener("pointerenter", warm, { once: true });
    opener?.addEventListener("focus", warm, { once: true });

    let closing = 0;
    const open = () => {
      clearTimeout(closing);
      warm();
      show(initial?.dataset.menuPreview);
      menu.showModal();
      getLenis()?.stop();
      // un frame después: las transiciones necesitan un estado inicial ya pintado
      requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add("is-open")));
    };
    const close = () => {
      if (!menu.open || !menu.classList.contains("is-open")) return;
      menu.classList.remove("is-open");
      closing = window.setTimeout(() => menu.close(), reduced() ? 0 : 800);
    };

    opener?.addEventListener("click", open);
    menu.querySelector("[data-menu-close]")?.addEventListener("click", close);
    menu.querySelector("[data-menu-dim]")?.addEventListener("click", close);
    menu.addEventListener("cancel", (e) => {
      e.preventDefault();
      close();
    });
    menu.addEventListener("close", () => getLenis()?.start());

    menu.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((a) => {
      const preview = () => show(a.dataset.menuLink);
      a.addEventListener("pointerenter", preview);
      a.addEventListener("focus", preview);
      // Misma página: BaseLayout hace el scroll a la sección y aquí solo se cierra el menú.
      // Desde un caso de estudio el dialog se va con la página; solo liberamos el scroll.
      a.addEventListener("click", () => {
        getLenis()?.start();
        close();
      });
    });
  });
</script>
