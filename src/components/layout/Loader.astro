---
// Loader de entrada del home (referencia: douglus.co). Solo la primera carga por sesión y nunca con
// reduced-motion. Mientras corre, html[data-loader] pausa el intro del hero y oculta el nav (global.css).
import { useTranslations, type Lang } from "~/i18n/utils";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
// Desfase horizontal de cada franja del logo (el "glitch" que se acomoda)
const shifts = [-7, 5, -3, 8, -5, 3];
---

<script is:inline>
  // Decide antes de pintar, por eso va inline y antes del markup.
  // El ClientRouter vuelve a correr este script al navegar: ahí el documento ya cargó y no hay loader.
  (() => {
    if (document.readyState !== "loading") return;
    try {
      if (sessionStorage.getItem("intro") || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      sessionStorage.setItem("intro", "1");
    } catch (e) {
      return;
    }
    const d = document.documentElement;
    d.setAttribute("data-loader", "");
    setTimeout(() => d.removeAttribute("data-loader"), 9000); // red de seguridad si el JS no llega
  })();
</script>

<div class="loader" aria-hidden="true">
  <div class="inverse absolute inset-0">
    <div class="loader-art">
      {shifts.map((x, k) => <span class="loader-frag" style={`--k:${k}; --x:${x}%`} />)}
    </div>
    <div data-loader-content class="wrapper relative flex h-full flex-col justify-end pb-[clamp(1.5rem,6svh,3.5rem)]">
      <p class="eyebrow loader-up">{t("hero.eyebrow")}</p>
      <p class="mt-3 overflow-hidden pb-[0.08em] text-[clamp(2.5rem,7vw,6.5rem)] leading-[0.95] font-extrabold tracking-[-0.055em]">
        <span class="loader-title block">Antonio Cortazar</span>
      </p>
      <div class="loader-up mt-6 flex items-center gap-4">
        <span class="relative h-px flex-1 bg-line">
          <span data-loader-bar class="absolute inset-0 origin-left bg-fg" style="transform: scaleX(0)"></span>
        </span>
        <span data-loader-pct class="w-10 text-right font-mono text-xs tabular-nums">0%</span>
      </div>
    </div>
  </div>
  <!-- Banda del color de la página: primero una línea, luego se abre y deja el hero a la vista -->
  <div data-loader-band class="absolute inset-0 bg-bg" style="transform: scaleY(0)"></div>
</div>

<style>
  .loader {
    display: none;
  }
  :global([data-loader]) .loader {
    position: fixed;
    inset: 0;
    z-index: 55; /* sobre el nav (50), bajo el grano (60) */
    display: block;
  }

  .loader-art {
    position: absolute;
    top: 42%;
    left: 50%;
    width: min(58vw, 44svh);
    aspect-ratio: 1;
    translate: -50% -50%;
  }
  .loader-frag {
    position: absolute;
    inset: 0;
    background: var(--fg);
    mask: url(/logo-ac.svg) center / contain no-repeat;
    clip-path: inset(calc(var(--k) * 16.667%) 0 calc(100% - (var(--k) + 1) * 16.667%) 0);
    opacity: 0.14;
    animation:
      frag-in 900ms var(--ease-out-expo) both calc(var(--k) * 45ms),
      frag-jitter 1.7s steps(1) infinite calc(900ms + var(--k) * 130ms);
  }
  .loader-title {
    animation: loader-title 1.4s var(--ease-out-expo) both 350ms;
  }
  .loader-up {
    animation: intro-up 900ms var(--ease-out-expo) both 200ms;
  }

  @keyframes frag-in {
    from {
      opacity: 0;
      translate: var(--x) 0;
      scale: 1.04;
    }
  }
  @keyframes frag-jitter {
    0%,
    100% {
      translate: 0;
    }
    31% {
      translate: var(--x) 0;
    }
    34% {
      translate: 0;
    }
    72% {
      translate: calc(var(--x) * -0.5) 0;
    }
    74% {
      translate: 0;
    }
  }
  @keyframes loader-title {
    from {
      translate: 0 110%;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const MIN = 1500; // ms mínimos de progreso, aunque todo ya esté en caché
  const EASE = "cubic-bezier(0.87, 0, 0.13, 1)";
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function run() {
    const q = (sel: string) => document.querySelector<HTMLElement>(sel);
    const bar = q("[data-loader-bar]");
    const pct = q("[data-loader-pct]");
    const content = q("[data-loader-content]");
    const band = q("[data-loader-band]");
    if (!bar || !pct || !content || !band) return root.removeAttribute("data-loader");

    // Progreso: avanza con el tiempo y se queda en 90 % hasta que cargan las fuentes
    let ready = false;
    document.fonts.ready.then(() => (ready = true));
    await new Promise<void>((done) => {
      const t0 = performance.now();
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / MIN);
        const p = Math.min(1 - (1 - k) ** 3, ready ? 1 : 0.9);
        bar.style.transform = `scaleX(${p})`;
        pct.textContent = `${Math.round(p * 100)}%`;
        if (p < 1) requestAnimationFrame(tick);
        else done();
      };
      requestAnimationFrame(tick);
    });

    await wait(250);
    await content.animate([{ opacity: 1 }, { opacity: 0, transform: "translateY(-1rem)" }], {
      duration: 450,
      easing: "cubic-bezier(0.76, 0, 0.24, 1)",
      fill: "forwards",
    }).finished;

    const line = 2 / innerHeight;
    await band.animate(
      [
        { transform: `scale(0, ${line})`, easing: "cubic-bezier(0.65, 0, 0.35, 1)" },
        { transform: `scale(1, ${line})`, offset: 0.4, easing: EASE },
        { transform: "scale(1, 1)" },
      ],
      { duration: 1400, fill: "forwards" },
    ).finished;

    // La banda ya es la página: se quita el loader y arranca el intro del hero
    root.removeAttribute("data-loader");
    window.__lenis?.start();
  }

  if (root.hasAttribute("data-loader")) run();
</script>
