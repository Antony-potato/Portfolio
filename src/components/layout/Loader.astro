---
// Loader de entrada del home: saludo corto y una cortina que se abre desde el centro (~2 s).
// Solo la primera carga por sesión y nunca con reduced-motion. Mientras corre, html[data-loader]
// pausa el intro del hero y oculta el nav (global.css); al abrirse la cortina pasa a data-loader="open"
// para que el hero entre a la vez y quede listo cuando termina.
import { useTranslations, type Lang } from "~/i18n/utils";

interface Props {
  lang: Lang;
}

const words = useTranslations(Astro.props.lang)("loader.welcome").split(" ");
---

<script is:inline>
  // Decide antes de pintar, por eso va inline y antes del markup.
  // El ClientRouter vuelve a correr este script al navegar: ahí el documento ya cargó y no hay loader.
  (() => {
    if (document.readyState !== "loading" || location.hash) return;
    try {
      if (sessionStorage.getItem("intro") || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      sessionStorage.setItem("intro", "1");
    } catch (e) {
      return;
    }
    const d = document.documentElement;
    d.setAttribute("data-loader", "");
    setTimeout(() => d.removeAttribute("data-loader"), 6000); // red de seguridad si el JS no llega
  })();
</script>

<div class="loader inverse" aria-hidden="true">
  <span data-loader-half class="loader-half top-0 origin-top"></span>
  <span data-loader-half class="loader-half bottom-0 origin-bottom"></span>
  <span data-loader-line class="loader-line"></span>
  <p data-loader-text class="loader-text">
    {words.map((w, i) => <span class="loader-word"><span style={`--i:${i}`}>{w}</span></span>)}
  </p>
</div>

<style>
  .loader {
    display: none;
  }
  :global([data-loader]) .loader {
    position: fixed;
    inset: 0;
    z-index: 55; /* sobre el nav (50), bajo el grano (60) */
    display: block;
    background: transparent; /* el color lo ponen las dos mitades */
  }

  .loader-half {
    position: absolute;
    inset-inline: 0;
    height: 50.5%;
    background: var(--bg);
  }
  .loader-line {
    position: absolute;
    inset-inline: 0;
    top: calc(50% - 1px);
    height: 2px;
    background: var(--fg);
    transform: scaleX(0);
  }
  .loader-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-wrap: wrap;
    place-content: center;
    gap: 0 0.26em;
    padding-inline: var(--gutter);
    font-size: clamp(2rem, 6vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .loader-word {
    display: inline-block;
    overflow: hidden;
    padding-block: 0.1em 0.18em;
    margin-block: -0.1em -0.18em;
  }
  .loader-word > span {
    display: inline-block;
    animation: loader-word 700ms var(--ease-out-expo) both calc(80ms + var(--i) * 60ms);
  }
  @keyframes loader-word {
    from {
      transform: translateY(125%);
    }
  }
</style>

<script>
  const root = document.documentElement;
  const EASE = "cubic-bezier(0.87, 0, 0.13, 1)";
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function run() {
    const text = document.querySelector<HTMLElement>("[data-loader-text]");
    const line = document.querySelector<HTMLElement>("[data-loader-line]");
    const halves = [...document.querySelectorAll<HTMLElement>("[data-loader-half]")];
    if (!text || !line || halves.length < 2) return root.removeAttribute("data-loader");

    await wait(1000); // el saludo ya entró y se alcanza a leer
    text.animate([{ opacity: 1 }, { opacity: 0, transform: "translateY(-0.5rem)" }], { duration: 300, easing: "ease-in", fill: "forwards" });
    await line.animate([{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }], { duration: 380, easing: EASE, fill: "forwards" }).finished;

    // La cortina se abre desde la línea; el hero y el nav arrancan su entrada al mismo tiempo
    root.setAttribute("data-loader", "open");
    line.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 150, fill: "forwards" });
    await Promise.all(
      halves.map((h) => h.animate([{ transform: "scaleY(1)" }, { transform: "scaleY(0)" }], { duration: 750, easing: EASE, fill: "forwards" }).finished),
    );

    root.removeAttribute("data-loader");
    window.__lenis?.start();
  }

  if (root.hasAttribute("data-loader")) run();
</script>
