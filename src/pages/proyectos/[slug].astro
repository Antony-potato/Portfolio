---
import { render } from "astro:content";
import ProjectLayout from "~/layouts/ProjectLayout.astro";
import { getProjects, projectSlug } from "~/lib/projects";

export async function getStaticPaths() {
  const sorted = await getProjects("es");
  return sorted.map((entry, i) => ({
    params: { slug: projectSlug(entry) },
    props: { entry, index: i + 1, total: sorted.length, nextEntry: sorted[(i + 1) % sorted.length] },
  }));
}

const { entry, index, total, nextEntry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ProjectLayout
  {...entry.data}
  slug={projectSlug(entry)}
  index={index}
  total={total}
  headings={headings}
  next={nextEntry && { slug: projectSlug(nextEntry), title: nextEntry.data.title, cover: nextEntry.data.cover }}
  lang="es"
>
  <Content />
</ProjectLayout>
