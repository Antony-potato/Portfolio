---
import { getCollection, render } from "astro:content";
import ProjectLayout from "~/layouts/ProjectLayout.astro";

export async function getStaticPaths() {
  const sorted = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, index: i + 1, total: sorted.length, nextEntry: sorted[(i + 1) % sorted.length] },
  }));
}

const { entry, index, total, nextEntry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ProjectLayout
  {...entry.data}
  index={index}
  total={total}
  headings={headings}
  next={nextEntry && { slug: nextEntry.id, title: nextEntry.data.title, cover: nextEntry.data.cover }}
  lang="es"
>
  <Content />
</ProjectLayout>
