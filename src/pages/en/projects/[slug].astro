---
import { render } from "astro:content";
import ProjectLayout from "~/layouts/ProjectLayout.astro";
import { getProjects, type Project } from "~/lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects("en");
  return projects.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  entry: Project;
  next: Project | undefined;
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const lang = "en" as const;
---

<ProjectLayout
  title={entry.data.title}
  summary={entry.data.summary}
  role={entry.data.role}
  year={entry.data.year}
  client={entry.data.client}
  stack={entry.data.stack}
  category={entry.data.category}
  cover={entry.data.cover}
  liveUrl={entry.data.liveUrl}
  repoUrl={entry.data.repoUrl}
  nextSlug={next?.slug}
  nextTitle={next?.data.title}
  lang={lang}
>
  <Content />
</ProjectLayout>
