---
import type { ImageMetadata, MarkdownHeading } from "astro";
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "./BaseLayout.astro";
import Button from "~/components/ui/Button.astro";
import SplitTitle from "~/components/ui/SplitTitle.astro";
import { useTranslations, getLocalizedPath, type Lang } from "~/i18n/utils";
import { SITE } from "~/lib/seo";

interface Props {
  title: string;
  summary: string;
  role: string;
  year: number;
  client?: string | undefined;
  stack: string[];
  category: string;
  cover: ImageMetadata;
  gallery?: ImageMetadata[] | undefined;
  metrics?: { label: string; value: string }[] | undefined;
  slug: string;
  liveUrl?: string | null | undefined;
  repoUrl?: string | null | undefined;
  index: number;
  total: number;
  headings: MarkdownHeading[];
  next?: { slug: string; title: string; cover: ImageMetadata } | undefined;
  lang: Lang;
}

const { title, summary, role, year, client, stack, category, cover, gallery = [], metrics = [], slug, liveUrl, repoUrl, index, total, headings, next, lang } =
  Astro.props;

const t = useTranslations(lang);
const base = lang === "es" ? "/proyectos" : "/projects";
const pad = (n: number) => String(n).padStart(2, "0");
const toc = headings.filter((h) => h.depth === 2);
// Galería: capturas de escritorio a lo ancho, las de móvil como teléfono al lado
const wide = gallery.filter((g) => g.width >= g.height);
const tall = gallery.filter((g) => g.width < g.height);
const og = `/og/${slug}.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description: summary,
  dateCreated: String(year),
  inLanguage: lang,
  url: new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString(),
  image: new URL(og, Astro.site ?? SITE.url).toString(),
  keywords: stack.join(", "),
  author: { "@type": "Person", name: SITE.author, url: SITE.url },
  ...(client && { sourceOrganization: { "@type": "Organization", name: client } }),
};

const specs = [
  { label: t("projects.role"), value: role },
  { label: t("projects.client"), value: client ?? "—" },
  { label: t("projects.year"), value: String(year) },
  { label: t("projects.category"), value: category.toUpperCase() },
];
---

<BaseLayout title={title} description={summary} type="article" image={og}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <header data-hero class="wrapper pt-[calc(var(--nav-h)+2.5rem)] md:pt-[calc(var(--nav-h)+4rem)]">
      <div class="eyebrow flex items-center justify-between gap-4">
        <a href={getLocalizedPath(lang, base)} class="group inline-flex items-center gap-2 text-fg">
          <Icon name="lucide:arrow-left" class="size-3.5 transition-transform duration-500 group-hover:-translate-x-1" aria-hidden="true" />
          <span class="roll"><span>{t("projects.back")}</span><span aria-hidden="true">{t("projects.back")}</span></span>
        </a>
        <span>{t("projects.case")} {pad(index)} / {pad(total)}</span>
      </div>

      <h1 class="mt-12 -ml-[0.04em] text-[clamp(3.25rem,13.5vw,15rem)] leading-[0.82] font-extrabold tracking-[-0.065em] md:mt-16">
        <span class="block"><SplitTitle text={title} /></span><span class="sr-only">{title}</span>
      </h1>

      <div class="relative mt-10 grid gap-10 pt-6 md:mt-14 lg:grid-cols-12 lg:gap-6">
        <span data-intro-line class="absolute inset-x-0 top-0 h-px bg-line"></span>
        <div data-intro-up style="--d:1" class="flex flex-col gap-8 lg:col-span-5">
          <p class="text-xl leading-snug tracking-[-0.01em] md:text-2xl">{summary}</p>
          <div class="flex flex-wrap gap-3">
            {
              liveUrl && (
                <Button href={liveUrl} external magnetic>
                  {t("projects.live")}
                  <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
                </Button>
              )
            }
            {
              repoUrl && (
                <Button href={repoUrl} variant="secondary" external>
                  <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
                  {t("projects.repo")}
                </Button>
              )
            }
          </div>
        </div>
        <dl data-intro-up style="--d:2" class="grid grid-cols-2 gap-x-6 self-start border-t border-line lg:col-span-6 lg:col-start-7 lg:border-t-0">
          {
            specs.map((s) => (
              <div class="flex flex-col gap-1 border-b border-line py-3">
                <dt class="eyebrow">{s.label}</dt>
                <dd class="font-medium">{s.value}</dd>
              </div>
            ))
          }
          <div class="col-span-2 flex flex-col gap-1 border-b border-line py-3">
            <dt class="eyebrow">{t("projects.stack")}</dt>
            <dd class="font-medium">{stack.join(" · ")}</dd>
          </div>
          {
            metrics.length > 0 && (
              <div class="col-span-2 flex flex-col gap-3 border-b border-line py-3">
                <dt class="eyebrow">{t("projects.metrics")}</dt>
                <dd class="flex flex-wrap gap-x-8 gap-y-3">
                  {metrics.map((m) => (
                    <span class="flex items-baseline gap-2">
                      <span class="text-3xl leading-none font-extrabold tracking-[-0.04em] tabular-nums">{m.value}</span>
                      <span class="text-sm text-muted">{m.label}</span>
                    </span>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    <figure class="wrapper mt-14 md:mt-20">
      <div class="relative aspect-[4/3] overflow-hidden rounded-md bg-surface md:aspect-[16/9]">
        <Picture
          data-parallax="6"
          src={cover}
          alt={title}
          formats={["avif", "webp"]}
          widths={[640, 1024, 1600, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 size-full scale-[1.12] object-cover"
        />
      </div>
    </figure>

    <div class="wrapper grid gap-12 py-24 md:py-36 lg:grid-cols-12 lg:gap-6">
      {
        toc.length > 0 && (
          <aside class="hidden lg:col-span-3 lg:block">
            <nav class="sticky top-[calc(var(--nav-h)+2rem)]" aria-label={t("projects.toc")}>
              <p class="eyebrow">{t("projects.toc")}</p>
              <ol class="mt-4 border-t border-line" data-toc>
                {toc.map((h, i) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="flex gap-4 border-b border-line py-3 text-sm text-muted transition-colors hover:text-fg aria-[current=true]:text-fg"
                    >
                      <span class="font-mono text-xs">{pad(i + 1)}</span>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
      <div class="prose lg:col-span-7 lg:col-start-5">
        <slot />
      </div>
    </div>

    {
      gallery.length > 0 && (
        <section class="wrapper pb-24 md:pb-36" aria-label={t("projects.gallery")}>
          <p class="eyebrow mb-6">{t("projects.gallery")}</p>
          <div class="grid items-stretch gap-4 md:grid-cols-12 md:gap-6">
            {wide.map((img) => (
              <div data-clip class="relative aspect-[16/10] overflow-hidden rounded-md bg-surface md:col-span-9 md:aspect-auto md:min-h-full">
                <Picture
                  data-parallax="5"
                  src={img}
                  alt={`${title} — ${lang === "es" ? "vista de escritorio" : "desktop view"}`}
                  formats={["avif", "webp"]}
                  widths={[640, 1024, 1440]}
                  sizes="(min-width: 768px) 75vw, 100vw"
                  loading="lazy"
                  class="absolute inset-0 size-full scale-[1.1] object-cover"
                />
              </div>
            ))}
            {tall.map((img) => (
              <div data-reveal="up" class="mx-auto w-2/3 overflow-hidden rounded-[2rem] border-4 border-fg bg-fg md:col-span-3 md:w-full">
                <Picture
                  src={img}
                  alt={`${title} — ${lang === "es" ? "vista móvil" : "mobile view"}`}
                  formats={["avif", "webp"]}
                  widths={[360, 720]}
                  sizes="(min-width: 768px) 25vw, 66vw"
                  loading="lazy"
                  class="block aspect-[390/844] w-full object-cover object-top"
                />
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      next && (
        <nav aria-label={t("projects.next")} class="border-t border-line">
          <a href={getLocalizedPath(lang, `${base}/${next.slug}`)} class="group wrapper relative flex flex-col gap-8 py-16 md:py-28">
            <span class="eyebrow flex items-center gap-4">
              <span class="text-fg">{t("projects.next")}</span>
              <span class="h-px flex-1 origin-left bg-line transition-transform duration-1000 ease-(--ease-out-expo) group-hover:bg-fg" />
              <Icon name="lucide:arrow-right" class="size-4 text-fg transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true" />
            </span>
            <span class="flex items-end justify-between gap-6">
              <span class="text-[clamp(3rem,12vw,13rem)] leading-[0.82] font-extrabold tracking-[-0.065em] transition-transform duration-700 ease-(--ease-out-expo) group-hover:translate-x-3">
                {next.title}
              </span>
              <span class="next-cover hidden aspect-[16/10] w-[min(26rem,30vw)] shrink-0 overflow-hidden rounded-md md:block">
                <Picture
                  src={next.cover}
                  alt=""
                  formats={["avif", "webp"]}
                  widths={[480, 900]}
                  sizes="30vw"
                  loading="lazy"
                  pictureAttributes={{ class: "block size-full" }}
                  class="size-full scale-110 object-cover transition-transform duration-1000 ease-(--ease-out-expo) group-hover:scale-100"
                />
              </span>
            </span>
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style is:global>
  .next-cover {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 900ms var(--ease-in-out-quart);
  }
  .group:hover .next-cover,
  .group:focus-visible .next-cover {
    clip-path: inset(0 0 0 0);
  }

  /* Prosa del caso de estudio — h2 numerados con contador CSS */
  .prose {
    max-width: 68ch;
    counter-reset: section;
    font-size: 1.125rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--fg) 82%, var(--bg));
  }
  .prose > * + * {
    margin-top: 1.25em;
  }
  .prose h2 {
    counter-increment: section;
    color: var(--fg);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.045em;
    margin-top: 3.5em;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  .prose h2::before {
    content: counter(section, decimal-leading-zero) " —";
    display: block;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .prose h2 + * {
    margin-top: 1.5rem;
  }
  .prose h3 {
    font-size: 1.5rem;
    margin-top: 2em;
  }
  .prose ul,
  .prose ol {
    display: grid;
    gap: 0.75rem;
    padding-left: 0;
  }
  .prose ul {
    list-style: none;
  }
  .prose ul li {
    position: relative;
    padding-left: 1.5rem;
  }
  .prose ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--color-accent-500);
  }
  .prose ul ul {
    margin-top: 0.75rem;
  }
  .prose ol {
    list-style: decimal-leading-zero inside;
  }
  .prose ol li::marker {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--muted);
  }
  .prose strong {
    color: var(--fg);
    font-weight: 600;
  }
  .prose em {
    font-style: italic;
  }
  .prose code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--surface);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }
  .prose a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-500);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
</style>

<script>
  // Scroll-spy del índice lateral
  let spy: IntersectionObserver | null = null;
  document.addEventListener("astro:page-load", () => {
    spy?.disconnect();
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc] a");
    if (!links.length) return;
    const byId = new Map([...links].map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    spy = new IntersectionObserver(
      (entries) => {
        const hit = entries.find((e) => e.isIntersecting);
        if (!hit) return;
        links.forEach((a) => a.removeAttribute("aria-current"));
        byId.get(hit.target.id)?.setAttribute("aria-current", "true");
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) spy?.observe(el);
    });
  });
</script>
