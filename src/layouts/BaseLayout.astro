---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "~/styles/global.css";
import Navbar from "~/components/layout/Navbar.astro";
import Footer from "~/components/layout/Footer.astro";
import Loader from "~/components/layout/Loader.astro";
import { getLangFromUrl, getAlternatePath } from "~/i18n/utils";
import { SITE, OG_VERSION, buildTitle, type SeoProps } from "~/lib/seo";

type Props = SeoProps & {
  /** Loader de entrada (solo home, primera carga por sesión) */
  loader?: boolean;
  /** Sin nav ni footer (tarjeta de contacto) */
  bare?: boolean;
};

const lang = getLangFromUrl(Astro.url);
const {
  title,
  description = SITE.defaultDescription,
  image = SITE.defaultImage,
  canonical = Astro.url.href,
  type = "website",
  loader = false,
  bare = false,
} = Astro.props;

const site = Astro.site ?? SITE.url;
const fullTitle = buildTitle(title);
const ogUrl = new URL(image, site);
ogUrl.searchParams.set("v", String(OG_VERSION));
const ogImageUrl = ogUrl.toString();
const alternates = [
  { hreflang: lang, href: new URL(Astro.url.pathname, site).toString() },
  { hreflang: lang === "es" ? "en" : "es", href: new URL(getAlternatePath(lang, Astro.url.pathname), site).toString() },
];

// Tema + flag de motion antes del primer paint (y tras cada navegación del ClientRouter)
const headInit = `(() => {
  const apply = () => {
    const d = document.documentElement;
    let saved = null;
    try { saved = localStorage.getItem("theme"); } catch (e) {}
    d.classList.toggle("theme-dark", saved === "dark");
  };
  apply();
  document.addEventListener("astro:after-swap", apply);
})();`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    {
      // Analítica sin cookies (Umami). Solo se carga si existe PUBLIC_UMAMI_WEBSITE_ID en el .env
      import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
        <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID} />
      )
    }

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={SITE.url} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />

    {/* Solo los pesos del primer pantallazo (nombre del hero y nav); el resto carga con swap */}
    <Font cssVariable="--font-sans" preload={[{ weight: 700 }, { weight: 500 }]} />
    <Font cssVariable="--font-mono" preload />

    <script is:inline set:html={headInit} />

    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    {loader && <Loader lang={lang} />}
    {!bare && <Navbar lang={lang} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}

    <script>
      // El motion (GSAP + Lenis + WebGL) se carga cuando el navegador queda libre: la primera
      // pintura y el intro (CSS) no lo esperan. Safari no tiene requestIdleCallback.
      const idle = (fn: () => void) =>
        "requestIdleCallback" in window ? requestIdleCallback(fn, { timeout: 1200 }) : setTimeout(fn, 150);
      const load = () => Promise.all([import("~/lib/lenis"), import("~/lib/animations")]);
      let page = 0;

      // Enlaces a una sección de esta misma página: scroll suave (con Lenis si ya cargó).
      // En captura y con preventDefault para que el ClientRouter no lo trate como navegación.
      addEventListener(
        "click",
        (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = (e.target as Element | null)?.closest<HTMLAnchorElement>("a[href*='#']");
          if (!a || a.target === "_blank") return;
          const url = new URL(a.href);
          const bare = (p: string) => p.replace(/\/$/, "");
          if (url.origin !== location.origin || bare(url.pathname) !== bare(location.pathname) || url.hash.length < 2) return;
          const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
          if (!target) return;
          e.preventDefault();
          history.replaceState(history.state, "", url.hash);
          const lenis = window.__lenis;
          if (lenis) {
            lenis.start(); // el menú lo deja en pausa mientras está abierto
            lenis.scrollTo(target);
          } else {
            target.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
          }
        },
        true,
      );

      document.addEventListener("astro:page-load", () => {
        const current = ++page;
        idle(async () => {
          const [lenis, anim] = await load();
          if (current !== page) return; // ya se navegó a otra página
          lenis.initLenis();
          anim.initAnimations();
        });
      });
      document.addEventListener("astro:before-swap", async () => {
        page++;
        const [lenis, anim] = await load();
        anim.teardownAnimations();
        lenis.destroyLenis();
      });
    </script>
  </body>
</html>
