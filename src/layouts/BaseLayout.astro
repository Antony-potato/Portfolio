---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "~/styles/global.css";
import Navbar from "~/components/layout/Navbar.astro";
import Footer from "~/components/layout/Footer.astro";
import { getLangFromUrl, getAlternatePath } from "~/i18n/utils";
import { SITE, buildTitle, type SeoProps } from "~/lib/seo";

type Props = SeoProps;

const lang = getLangFromUrl(Astro.url);
const {
  title,
  description = SITE.defaultDescription,
  image = SITE.defaultImage,
  canonical = Astro.url.href,
  type = "website",
} = Astro.props;

const site = Astro.site ?? SITE.url;
const fullTitle = buildTitle(title);
const ogImageUrl = new URL(image, site).toString();
const alternates = [
  { hreflang: lang, href: new URL(Astro.url.pathname, site).toString() },
  { hreflang: lang === "es" ? "en" : "es", href: new URL(getAlternatePath(lang, Astro.url.pathname), site).toString() },
];

// Tema + flag de motion antes del primer paint (y tras cada navegación del ClientRouter)
const headInit = `(() => {
  const apply = () => {
    const d = document.documentElement;
    let saved = null;
    try { saved = localStorage.getItem("theme"); } catch (e) {}
    d.classList.toggle("theme-dark", saved === "dark");
  };
  apply();
  document.addEventListener("astro:after-swap", apply);
})();`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f2ed" />
    {
      // Analítica sin cookies (Umami). Solo se carga si existe PUBLIC_UMAMI_WEBSITE_ID en el .env
      import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
        <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID} />
      )
    }

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={SITE.url} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />

    <script is:inline set:html={headInit} />

    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <Navbar lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // El motion (GSAP + Lenis + WebGL) se carga cuando el navegador queda libre: la primera
      // pintura y el intro (CSS) no lo esperan. Safari no tiene requestIdleCallback.
      const idle = (fn: () => void) =>
        "requestIdleCallback" in window ? requestIdleCallback(fn, { timeout: 1200 }) : setTimeout(fn, 150);
      const load = () => Promise.all([import("~/lib/lenis"), import("~/lib/animations")]);
      let page = 0;

      document.addEventListener("astro:page-load", () => {
        const current = ++page;
        idle(async () => {
          const [lenis, anim] = await load();
          if (current !== page) return; // ya se navegó a otra página
          lenis.initLenis();
          anim.initAnimations();
        });
      });
      document.addEventListener("astro:before-swap", async () => {
        page++;
        const [lenis, anim] = await load();
        anim.teardownAnimations();
        lenis.destroyLenis();
      });
    </script>
  </body>
</html>
